# dependencies (builder runs npm ci / npm install)
web/node_modules/
node_modules/
lib/mentiko-mcp/node_modules/
lib/mentiko-mcp/dist/

# build output (builder runs next build inside the image)
# scope the .next ignore to /cache so phase 4's artifact-share path can
# stage a pre-built /standalone and /static into web/.next/ on the host
# before docker build runs. when SKIP_NEXT_BUILD=1 the Dockerfile's
# COPY . /build/ picks them up; on a normal local build web/.next/ is
# empty and the in-image `next build` writes there as before.
web/.next/cache/
web/out/

# git
.git/
.gitignore

# dev/test artifacts
web/.env*
web/coverage/
web/e2e/
web/__mocks__/
web/**/*.test.ts
web/**/*.test.tsx
web/**/*.spec.ts

# ide
.vscode/
.idea/
*.swp
*.swo

# os
.DS_Store
Thumbs.db

# docs (not needed in image)
docs/
!docs/orchestration/
!docs/orchestration/contracts/
!docs/orchestration/contracts/*.json
*.md
LICENSE

# claude code worktrees + trash
.claude/
.trash/
 
# debug artifacts
web/debug/
memory/
__pycache__/
