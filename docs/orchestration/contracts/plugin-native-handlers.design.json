{
  "version": 1,
  "shape": "plugin-registry",
  "owner": "web/lib/system/native-plugin-handler-cli.ts",
  "builtins": {
    "github-pr": {
      "manifest": "nativeHandler",
      "typed_operations": ["validate configuration", "probe Git branch through external git CLI", "query and create GitHub pull requests"],
      "external_boundaries": ["git", "GitHub REST API"]
    },
    "linear": {
      "manifest": "nativeHandler",
      "typed_operations": ["validate configuration", "resolve team and workflow state", "create Linear issue"],
      "external_boundaries": ["Linear GraphQL API"]
    },
    "notify-email": {
      "manifest": "nativeHandler",
      "typed_operations": ["filter event", "construct transactional email envelope", "check delivery response"],
      "external_boundaries": ["Mentiko internal email API"]
    },
    "email-digest": {
      "manifest": "nativeHandler",
      "typed_operations": ["validate absolute buffer path", "lock and append JSONL", "claim flush by rename", "construct digest envelope", "restore claim on delivery failure"],
      "external_boundaries": ["Mentiko internal email API"]
    }
  },
  "excluded": ["notify-slack"],
  "invariant": "No listed built-in has onEventScript or a shell-owned parser, payload constructor, persisted buffer mutation, or fallback path."
}
