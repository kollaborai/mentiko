{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentiko.com/schemas/database-lifecycle/fixture-v1.json",
  "title": "Mentiko database lifecycle fixture",
  "type": "object",
  "required": [
    "fixture_id",
    "schema_status",
    "title",
    "namespace",
    "initial_state",
    "actions",
    "expected"
  ],
  "properties": {
    "fixture_id": { "type": "string", "pattern": "^FIX-DBL-[0-9]{3}$" },
    "schema_status": { "const": "proposed" },
    "title": { "type": "string", "minLength": 1 },
    "namespace": {
      "type": "object",
      "required": ["id", "org_id", "data_root", "artifact_root"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "org_id": { "type": "string", "minLength": 1 },
        "data_root": { "type": "string", "minLength": 1 },
        "artifact_root": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "current_runtime_observations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "initial_state": { "$ref": "#/$defs/state" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action_id", "kind", "principal", "idempotency_key", "input"],
        "properties": {
          "action_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "principal": { "type": "object", "required": ["type", "id"], "additionalProperties": true },
          "idempotency_key": { "type": "string", "minLength": 1 },
          "input": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "expected": {
      "type": "object",
      "required": ["transitions", "final_state"],
      "properties": {
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["action_id", "accepted", "must_not"],
            "properties": {
              "action_id": { "type": "string" },
              "accepted": { "type": "boolean" },
              "event_types": { "type": "array", "items": { "type": "string" } },
              "command_ids": { "type": "array", "items": { "type": "string" } },
              "created_ids": { "type": "array", "items": { "type": "string" } },
              "rejection_code": { "type": "string" },
              "waiting_reason": { "type": "string" },
              "must_not": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        },
        "final_state": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "required": [
        "tasks",
        "workflow_instances",
        "workflow_steps",
        "runs",
        "agent_attempts",
        "lifecycle_events",
        "lifecycle_commands",
        "artifact_refs"
      ],
      "properties": {
        "tasks": { "type": "array" },
        "workflow_instances": { "type": "array" },
        "workflow_steps": { "type": "array" },
        "runs": { "type": "array" },
        "agent_attempts": { "type": "array" },
        "lifecycle_events": { "type": "array" },
        "lifecycle_commands": { "type": "array" },
        "artifact_refs": { "type": "array" },
        "execution_reservations": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
