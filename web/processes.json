{
  "version": 1,
  "processes": [
    {
      "name": "pty-mgr",
      "cmd": "/usr/local/bin/pty-mgr",
      "args": ["daemon"],
      "env": {},
      "cwd": "/opt/mentiko",
      "daemonize": true,
      "readiness": {
        "type": "socket",
        "path": "$HOME/.pty-manager/default.sock",
        "timeout": 10000,
        "interval": 250
      },
      "restart": {
        "enabled": true,
        "maxRestarts": 15,
        "baseDelay": 1000,
        "maxDelay": 30000,
        "resetAfter": 60000,
        "jitter": true
      },
      "critical": true,
      "order": 1
    },
    {
      "name": "ws-terminal",
      "cmd": "node",
      "args": ["server/ws-terminal.js"],
      "env": {
        "WS_TERMINAL_PORT": "3099"
      },
      "cwd": "/opt/mentiko",
      "dependsOn": ["pty-mgr"],
      "readiness": {
        "type": "port",
        "port": 3099,
        "timeout": 5000,
        "interval": 250
      },
      "restart": {
        "enabled": true,
        "maxRestarts": 10,
        "baseDelay": 1000,
        "maxDelay": 30000,
        "resetAfter": 60000
      },
      "critical": true,
      "order": 2
    },
    {
      "name": "platform",
      "cmd": "node",
      "args": ["server.js"],
      "env": {
        "PORT": "3000"
      },
      "cwd": "/opt/mentiko",
      "dependsOn": ["ws-terminal"],
      "readiness": {
        "type": "http",
        "url": "http://127.0.0.1:3000/api/health",
        "timeout": 90000,
        "interval": 500
      },
      "restart": {
        "enabled": true,
        "maxRestarts": 5,
        "baseDelay": 2000,
        "maxDelay": 30000,
        "resetAfter": 120000
      },
      "critical": true,
      "order": 3
    },
    {
      "name": "worker",
      "cmd": "node",
      "args": ["server/background-worker.js"],
      "env": {},
      "cwd": "/opt/mentiko",
      "dependsOn": ["platform"],
      "restart": {
        "enabled": true,
        "maxRestarts": 10,
        "baseDelay": 2000,
        "maxDelay": 60000,
        "resetAfter": 120000
      },
      "critical": false,
      "order": 4
    },
    {
      "name": "kollabor-engine",
      "cmd": "/opt/pipx/venvs/kollab/bin/python",
      "args": ["-m", "kollabor_engine", "serve", "--port", "7433"],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "INTERNAL_SERVICE_SECRET": "$INTERNAL_SERVICE_SECRET"
      },
      "cwd": "/opt/mentiko",
      "dependsOn": ["pty-mgr"],
      "readiness": {
        "type": "http",
        "url": "http://127.0.0.1:7433/health",
        "timeout": 10000,
        "interval": 500
      },
      "restart": {
        "enabled": true,
        "maxRestarts": 10,
        "baseDelay": 2000,
        "maxDelay": 30000,
        "resetAfter": 120000
      },
      "critical": false,
      "order": 5
    }
  ]
}
