          "readiness": { "enabled": true, "ready_patterns": [ { "name": "kollab ready line", "type": "text", "value": "ready ·", "action": "ready", "risk": "low", "enabled": true }, { "name": "kollab hooks active", "type": "text", "value": "hooks active", "action": "ready", "risk": "low", "enabled": true } ] },
          "description": "Kollab / Mentiko"
