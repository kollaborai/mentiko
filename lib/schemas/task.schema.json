{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Definition",
  "description": "Schema for generating tasks via AI",
  "type": "object",
  "required": ["title", "type", "priority"],
  "allOf": [
    {
      "if": {
        "properties": {
          "subtasks": { "type": "array", "minItems": 1 }
        },
        "required": ["subtasks"]
      },
      "then": {
        "properties": {
          "type": { "const": "epic" }
        }
      }
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Short, actionable task title",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Detailed description of what needs to be done"
    },
    "type": {
      "type": "string",
      "enum": ["epic", "feature", "task", "bug", "chore"],
      "description": "Task type: epic (large milestone), feature (new functionality), task (general work), bug (defect fix), chore (maintenance)"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "Priority: 0=critical, 1=high, 2=medium, 3=low, 4=backlog"
    },
    "acceptance_criteria": {
      "type": "string",
      "description": "Newline-delimited acceptance criteria for when this task is considered done"
    },
    "design": {
      "type": "string",
      "description": "Technical design notes, architecture decisions, implementation approach"
    },
    "notes": {
      "type": "string",
      "description": "Additional context, references, or notes"
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Labels/tags for categorization (e.g. 'frontend', 'api', 'infrastructure')"
    },
    "subtasks": {
      "type": "array",
      "description": "Breakdown into subtasks (only for epics or complex features)",
      "items": {
        "type": "object",
        "required": ["title", "description", "type", "priority"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Subtask title",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "description": "Subtask description",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["feature", "task", "bug", "chore"]
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "acceptance_criteria": {
            "type": "string",
            "description": "Newline-delimited acceptance criteria for when this subtask is considered done"
          },
          "labels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "description": "Zero-based indices of other subtasks this one depends on (e.g. [0] means depends on the first subtask)"
          }
        }
      }
    }
  }
}
