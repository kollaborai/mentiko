{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chain Run",
  "description": "Schema for chain execution runs",
  "type": "object",
  "required": ["id", "chainId", "chainName", "goal", "started", "status"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique run identifier",
      "format": "uuid"
    },
    "chainId": {
      "type": "string",
      "description": "Chain identifier being run"
    },
    "chainName": {
      "type": "string",
      "description": "Chain name"
    },
    "chainFile": {
      "type": "string",
      "description": "Path to chain configuration file"
    },
    "goal": {
      "type": "string",
      "description": "Goal or prompt for this run"
    },
    "started": {
      "type": "string",
      "description": "ISO 8601 timestamp when run started",
      "format": "date-time"
    },
    "completed": {
      "type": "string",
      "description": "ISO 8601 timestamp when run completed",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "description": "Current run status",
      "enum": ["running", "complete", "failed", "cancelled"]
    },
    "duration": {
      "type": "number",
      "description": "Run duration in seconds"
    },
    "round": {
      "type": "integer",
      "description": "Current iteration round",
      "minimum": 1
    },
    "agentCount": {
      "type": "integer",
      "description": "Number of agents in the chain",
      "minimum": 1
    },
    "sessions": {
      "type": "array",
      "description": "Tmux session names for this run",
      "items": { "type": "string" }
    },
    "agents": {
      "type": "array",
      "description": "Agent execution states",
      "items": {
        "type": "object",
        "required": ["id", "agentId", "status"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Session identifier"
          },
          "agentId": {
            "type": "string",
            "description": "Agent identifier"
          },
          "agentName": {
            "type": "string",
            "description": "Agent name"
          },
          "status": {
            "type": "string",
            "description": "Agent execution status",
            "enum": ["pending", "running", "complete", "failed"]
          },
          "started": {
            "type": "string",
            "description": "ISO 8601 timestamp",
            "format": "date-time"
          },
          "completed": {
            "type": "string",
            "description": "ISO 8601 timestamp",
            "format": "date-time"
          },
          "output": {
            "type": "string",
            "description": "Agent output"
          },
          "error": {
            "type": "string",
            "description": "Error message if failed"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "description": "Events logged during this run",
      "items": {
        "type": "object",
        "required": ["event", "timestamp"],
        "properties": {
          "event": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional run metadata",
      "properties": {
        "triggeredBy": {
          "type": "string",
          "description": "What triggered this run (manual, schedule, webhook)"
        },
        "triggerSource": {
          "type": "string",
          "description": "Source identifier (schedule id, webhook url, etc.)"
        },
        "userId": {
          "type": "string",
          "description": "User who initiated the run"
        },
        "workspace": {
          "type": "string",
          "description": "Workspace directory"
        }
      }
    }
  }
}
