{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mentiko.dev/schemas/run.schema.json",
  "title": "Chain Run",
  "description": "Persisted runs/{runId}/run.json contract shared by the shell runner, web launcher, and runner-v2 state machine.",
  "type": "object",
  "required": ["id", "chain", "goal", "started", "status", "agents"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^run-[A-Za-z0-9_-]{1,120}$",
      "description": "Collision-resistant run identifier minted by lib/run-lib.sh or runner-v2/run-state.ts."
    },
    "chain": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable chain name."
    },
    "chainId": {
      "type": "string",
      "description": "Stable chain identifier when the launching surface has one."
    },
    "goal": {
      "type": "string"
    },
    "started": {
      "type": "string",
      "format": "date-time"
    },
    "completed": {
      "type": "string",
      "format": "date-time"
    },
    "resumedAt": {
      "type": "string",
      "format": "date-time"
    },
    "blockedAt": {
      "type": "string",
      "format": "date-time"
    },
    "blockedReason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "description": "Canonical run status.",
      "enum": ["pending", "running", "blocked", "failed", "stopped", "completed", "cancelled", "stalled"]
    },
    "status_message": {
      "type": "string"
    },
    "debug": {
      "type": "boolean"
    },
    "sessions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "PTY session names. Optional during the web launcher's pre-session write."
    },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/definitions/runAgent" }
    },
    "parent_run_id": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    },
    "workspacePath": {
      "type": "string"
    },
    "workspaceExecution": {
      "oneOf": [
        { "$ref": "#/definitions/gitWorkspaceExecution" },
        { "$ref": "#/definitions/unavailableWorkspaceExecution" }
      ]
    },
    "taskId": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "Optional run category such as link or chain."
    },
    "linkId": {
      "type": "string",
      "description": "Stable link identifier for link runs."
    },
    "agentProfileId": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "runnerV2": {
      "$ref": "#/definitions/runnerV2State"
    }
  },
  "definitions": {
    "gitWorkspaceExecution": {
      "type": "object",
      "required": [
        "version",
        "tracking",
        "sourceWorkspacePath",
        "baselineArtifactPath",
        "isolation",
        "concurrentWritesIsolated",
        "baseline",
        "handoffs"
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "tracking": { "const": "git" },
        "sourceWorkspacePath": { "type": "string" },
        "baselineArtifactPath": { "type": "string" },
        "isolation": { "type": "string", "enum": ["shared", "git-worktree"] },
        "concurrentWritesIsolated": { "type": "boolean" },
        "baseline": { "$ref": "#/definitions/gitWorkspaceSnapshot" },
        "isolationStatePath": { "type": "string" },
        "baselineRef": { "type": "string" },
        "integrationRef": { "type": "string" },
        "handoffs": {
          "type": "array",
          "items": { "$ref": "#/definitions/workspaceHandoffRecord" }
        }
      }
    },
    "unavailableWorkspaceExecution": {
      "type": "object",
      "required": [
        "version",
        "tracking",
        "baselineArtifactPath",
        "isolation",
        "concurrentWritesIsolated",
        "reason",
        "recordedAt",
        "handoffs"
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "tracking": { "const": "unavailable" },
        "sourceWorkspacePath": { "type": "string" },
        "baselineArtifactPath": { "type": "string" },
        "isolation": { "const": "shared" },
        "concurrentWritesIsolated": { "const": false },
        "reason": { "type": "string", "minLength": 1 },
        "recordedAt": { "type": "string", "format": "date-time" },
        "handoffs": {
          "type": "array",
          "items": { "$ref": "#/definitions/workspaceHandoffRecord" }
        }
      }
    },
    "gitWorkspaceSnapshot": {
      "type": "object",
      "required": [
        "version",
        "kind",
        "capturedAt",
        "sourceWorkspacePath",
        "repositoryRoot",
        "relativeWorkspacePath",
        "snapshotCommit",
        "snapshotTree",
        "dirtyFromHead"
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "kind": { "const": "git" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "sourceWorkspacePath": { "type": "string" },
        "repositoryRoot": { "type": "string" },
        "gitCommonDir": { "type": "string" },
        "relativeWorkspacePath": { "type": "string" },
        "sourceHead": { "type": "string" },
        "sourceBranch": { "type": "string" },
        "sourceIndexSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "baseCommit": { "type": "string" },
        "snapshotCommit": { "type": "string" },
        "snapshotTree": { "type": "string" },
        "dirtyFromHead": { "type": "boolean" }
      }
    },
    "workspaceHandoffRecord": {
      "type": "object",
      "required": ["attemptId", "agentId", "capturedAt", "artifactPath", "tracking"],
      "additionalProperties": false,
      "properties": {
        "attemptId": { "type": "string", "minLength": 1 },
        "agentId": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "artifactPath": { "type": "string" },
        "tracking": { "type": "string", "enum": ["git", "unavailable"] },
        "nodeWorkspaceRecordPath": { "type": "string" }
      }
    },
    "runAgent": {
      "type": "object",
      "required": ["id", "name", "session", "status"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "session": { "type": "string" },
        "status": {
          "type": "string",
          "description": "Canonical run-agent status.",
          "enum": ["pending", "running", "blocked", "failed", "stopped", "cancelled", "complete", "error"]
        },
        "started": { "type": "string", "format": "date-time" },
        "queuedAt": { "type": "string", "format": "date-time" },
        "completed": { "type": "string", "format": "date-time" },
        "lastHeartbeat": { "type": "string", "format": "date-time" },
        "lastMessage": { "type": "string" }
      }
    },
    "runnerV2State": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "attempts": {
          "type": "array",
          "items": { "$ref": "#/definitions/agentAttempt" }
        },
        "stuckEvents": {
          "type": "array",
          "items": { "$ref": "#/definitions/stuckEvent" }
        },
        "pendingHandoffs": {
          "type": "array",
          "items": { "$ref": "#/definitions/pendingHandoff" }
        },
        "launchJobs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/routedLaunchJob" }
        }
      }
    },
    "agentAttempt": {
      "type": "object",
      "required": [
        "id",
        "runId",
        "agentId",
        "phase",
        "instructionLedger",
        "recoveryDecisionCount",
        "createdAt",
        "updatedAt",
        "transitions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "runId": { "type": "string" },
        "agentId": { "type": "string" },
        "phase": { "$ref": "#/definitions/attemptPhase" },
        "desiredPhase": { "$ref": "#/definitions/attemptPhase" },
        "observedPhase": { "$ref": "#/definitions/attemptPhase" },
        "terminalReason": { "$ref": "#/definitions/attemptReason" },
        "terminalDetail": { "type": "string" },
        "releaseReason": { "$ref": "#/definitions/attemptReason" },
        "leaseId": { "type": "string" },
        "leaseAcquiredAt": { "type": "string", "format": "date-time" },
        "leaseReleasedAt": { "type": "string", "format": "date-time" },
        "capacitySlotAcquiredAt": { "type": "string", "format": "date-time" },
        "capacitySlotReleasedAt": { "type": "string", "format": "date-time" },
        "launchJobId": { "type": "string", "minLength": 1 },
        "launchOccurrenceId": { "type": "string", "minLength": 1 },
        "queueEnteredAt": { "type": "string", "format": "date-time" },
        "queueSequence": { "type": "integer", "minimum": 1 },
        "processEvidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "processPid": { "type": "integer", "minimum": 1 },
            "processSpawnedAt": { "type": "string", "format": "date-time" },
            "ptySessionId": { "type": "string" }
          }
        },
        "instructionLedger": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["idempotencyKey", "submittedAt", "instructionPath", "pointer"],
            "additionalProperties": false,
            "properties": {
              "idempotencyKey": { "type": "string" },
              "submittedAt": { "type": "string", "format": "date-time" },
              "instructionPath": { "type": "string" },
              "pointer": { "type": "string" }
            }
          }
        },
        "recoveryDecisionCount": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "at"],
            "additionalProperties": false,
            "properties": {
              "from": { "$ref": "#/definitions/attemptPhase" },
              "to": { "$ref": "#/definitions/attemptPhase" },
              "at": { "type": "string", "format": "date-time" },
              "reason": { "$ref": "#/definitions/attemptReason" },
              "detail": { "type": "string" }
            }
          }
        },
        "origin": {
          "type": "string",
          "enum": ["routed-completion-adoption"]
        }
      }
    },
    "pendingHandoff": {
      "type": "object",
      "required": ["pid", "targetAgentIds", "startedAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pid": { "type": "integer", "minimum": 1 },
        "targetAgentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "heartbeatAt": { "type": "string", "format": "date-time" }
      }
    },
    "routedLaunchJob": {
      "type": "object",
      "required": [
        "version",
        "id",
        "occurrenceId",
        "runId",
        "runDir",
        "chainPath",
        "targets",
        "environment",
        "status",
        "attemptCount",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "occurrenceId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "runDir": { "type": "string", "minLength": 1 },
        "chainPath": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["agentId"],
            "additionalProperties": false,
            "properties": {
              "agentId": { "type": "string", "minLength": 1 },
              "attemptId": { "type": "string", "minLength": 1 }
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "status": { "type": "string", "enum": ["queued", "leased", "completed", "blocked"] },
        "lease": {
          "type": "object",
          "required": ["ownerId", "acquiredAt", "heartbeatAt", "expiresAt"],
          "additionalProperties": false,
          "properties": {
            "ownerId": { "type": "string", "minLength": 1 },
            "pid": { "type": "integer", "minimum": 1 },
            "acquiredAt": { "type": "string", "format": "date-time" },
            "heartbeatAt": { "type": "string", "format": "date-time" },
            "expiresAt": { "type": "string", "format": "date-time" }
          }
        },
        "attemptCount": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "blockedAt": { "type": "string", "format": "date-time" },
        "lastError": { "type": "string" }
      }
    },
    "stuckEvent": {
      "type": "object",
      "required": ["attemptId", "runId", "agentId", "phase", "reason", "emittedAt"],
      "additionalProperties": false,
      "properties": {
        "attemptId": { "type": "string" },
        "runId": { "type": "string" },
        "agentId": { "type": "string" },
        "desiredPhase": { "$ref": "#/definitions/attemptPhase" },
        "observedPhase": { "$ref": "#/definitions/attemptPhase" },
        "phase": { "$ref": "#/definitions/attemptPhase" },
        "reason": { "$ref": "#/definitions/attemptReason" },
        "emittedAt": { "type": "string", "format": "date-time" }
      }
    },
    "attemptPhase": {
      "type": "string",
      "enum": [
        "created",
        "queued",
        "lease_acquired",
        "pty_allocated",
        "process_spawned",
        "ready_for_instructions",
        "instructions_submitted",
        "completed",
        "completion_failed",
        "startup_failed",
        "human_action_required",
        "stuck",
        "released"
      ]
    },
    "attemptReason": {
      "type": "string",
      "enum": [
        "completed_from_event",
        "completed_from_declared_event",
        "completed_from_durable_marker",
        "completed_from_cross_run_event",
        "completed_from_handoff_artifact",
        "completed_from_generation_artifact",
        "completed_empty_emits_last_agent",
        "no_completion_event",
        "retries_exhausted",
        "readiness_deadline_expired",
        "readiness_policy_blocked",
        "readiness_policy_recoverable",
        "readiness_policy_retry",
        "readiness_no_ready_signal",
        "concurrency_cap_blocked",
        "workspace_integration_conflict",
        "source_workspace_changed",
        "agent_capacity_timeout",
        "auth_prompt_detected",
        "instruction_submission_unconfirmed",
        "invalid_transition",
        "reconciliation_window_expired",
        "released"
      ]
    }
  }
}
