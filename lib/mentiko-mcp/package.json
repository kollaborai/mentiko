{
  "name": "@kollaborai/mentiko-mcp",
  "version": "0.1.0",
  "description": "Mentiko MCP server — exposes Mentiko platform operations to MCP clients (Claude Desktop, Claude Code, etc.)",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "mentiko-mcp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.js",
    "dev": "tsx server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
