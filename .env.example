# mentiko platform - environment configuration
# copy this file to .env and edit before running docker compose
#
# usage:
#   cp .env.example .env
#   docker compose -f docker-compose.production.yml up -d

# ---------------------------------------------------------------------------
# required
# ---------------------------------------------------------------------------

# random secret for session signing (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=change-me-to-a-random-string

# ---------------------------------------------------------------------------
# optional: server
# ---------------------------------------------------------------------------

# public URL (used for OAuth redirects + cookie domain)
BETTER_AUTH_URL=http://localhost:3000

# host ports (left side of the docker port mapping). Container internal ports
# are currently fixed at 3000 / 3099; change ONLY these values to remap the host.
PORT=3000
WS_PORT=3099

# ---------------------------------------------------------------------------
# optional: terminal (ws-terminal bridge)
# ---------------------------------------------------------------------------

# In "direct" mode (the default), the browser connects to ws://{host}:{WS_PORT}.
# This works when WS_PORT == 3099 (the container's internal port). If you remap
# WS_PORT to anything else, switch to "proxy" mode below, OR put a reverse proxy
# in front of the container so /ws/terminal lands on the published port.
#
# Reverse-proxy mode: the terminal shares the same host:port as the rest of
# the app, routed via {WS_TERMINAL_PROXY_PATH} (default /ws/terminal). Point
# this at the container's internal port 3099 from your nginx/caddy/traefik
# config.
#MENTIKO_TERMINAL_PROXY=true
#WS_TERMINAL_PROXY_PATH=/ws/terminal

# extra browser origins permitted to connect to ws-terminal, comma-separated.
# localhost is always allowed. add your public domain(s) here when serving
# the UI from anything other than localhost. supports "*.example.com" wildcards.
#WS_ALLOWED_ORIGINS=https://mentiko.example.com,https://*.example.com

# comma-separated emails that get admin role on first login
ADMIN_EMAILS=

# AI provider keys are managed in the secrets vault UI (/settings/secrets)

# ---------------------------------------------------------------------------
# optional: OAuth login (GitHub, Google)
# ---------------------------------------------------------------------------

# GitHub: https://github.com/settings/developers -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# optional: integrations
# ---------------------------------------------------------------------------

# Slack (send webhook notifications on chain events)
SLACK_WEBHOOK_URL=

# GitHub (create issues on chain errors)
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# optional: email (signup verification, password reset, notifications)
# ---------------------------------------------------------------------------
# If neither RESEND_API_KEY nor SMTP_USER/SMTP_PASS is set, emails are logged
# to the container console (signup + password reset still succeed, but the
# user never receives an email). Pick ONE of the two paths below.
#
# Path 1 (recommended): Resend — sign up at https://resend.com and create
# an API key. Resend wins if both are set.
#RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
#SMTP_FROM=Mentiko <noreply@yourdomain.com>
#
# Path 2: generic SMTP (Titan, Postmark, SES, Mailgun, your own MTA, etc.)
#SMTP_HOST=smtp.titan.email
#SMTP_PORT=465
#SMTP_USER=noreply@yourdomain.com
#SMTP_PASS=
#SMTP_FROM=Mentiko <noreply@yourdomain.com>

# ---------------------------------------------------------------------------
# optional: error monitoring
# ---------------------------------------------------------------------------

SENTRY_DSN=

# ---------------------------------------------------------------------------
# CLI / local dev (not needed for docker)
# ---------------------------------------------------------------------------

# Root directory of the mentiko project
#MENTIKO_ROOT=/path/to/mentiko

# Default AI CLI to use (claude, glm, aider, ollama, etc.)
#DEFAULT_CLI=claude

# Maximum concurrent agents
#MAX_CONCURRENT_AGENTS=10

# ---------------------------------------------------------------------------
# mentiko-mcp (browser concierge MCP server)
# ---------------------------------------------------------------------------
# Shared secret between the mentiko-mcp stdio subprocess and the
# /api/mentiko-mcp/* platform routes. If unset, the process manager
# generates a random one at container boot. Set explicitly only if
# multiple processes need to agree out-of-band.
#MENTIKO_INBOX_KEY=

# URL the MCP subprocess uses to reach the platform. Default is the
# in-container loopback; override only in unusual topologies.
#MENTIKO_WEB_URL=http://127.0.0.1:3000
