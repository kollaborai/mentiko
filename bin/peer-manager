#!/bin/bash
# peer-manager - orchestrate two agents in a ping-pong collaboration
#
# one process manages the full lifecycle:
#   1. spawn both agents
#   2. send initial prompts
#   3. capture peer-2's "ready" message, send to peer-1
#   4. ping-pong: wait for stable -> capture -> clean -> send to other
#
# usage: peer-manager <task> [--profile <id>] [--watch]
#        peer-manager --resume <meeting-id>

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export MENTIKO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/../lib/config.sh"
source "$SCRIPT_DIR/../lib/agent-profile.sh"
source "$SCRIPT_DIR/../lib/session-log-resolver.sh"
source "$SCRIPT_DIR/../lib/session-transport.sh"
source "$SCRIPT_DIR/../lib/run-lib.sh" 2>/dev/null || true
source "$SCRIPT_DIR/../lib/run-record-client.sh"

# log crashes (set -e exits)
trap '_sys_log "error" "peer-manager" "CRASHED at line $LINENO (exit $?)" "peer1: ${PEER1:-unknown}, peer2: ${PEER2:-unknown}, run: ${LINK_RUN_ID:-unknown}"' ERR

P="$BIN_DIR/p"

# cross-platform md5
_md5() { if command -v md5 >/dev/null 2>&1; then md5 -q; else md5sum | cut -d' ' -f1; fi; }

# json helper - avoids inline python3 scattered everywhere
_json_get() { python3 -c "import json,sys; print(json.load(sys.stdin).get('$1','$2'))" 2>/dev/null; }
_json_escape() { python3 -c "import json,sys; print(json.dumps(sys.stdin.read().strip()))" 2>/dev/null || echo '""'; }
_shell_quote() { printf "'%s'" "$(printf "%s" "$1" | sed "s/'/'\\\\''/g")"; }
_safe_profile_id() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]]; }

log() { echo "  [manager] $*" >&2; }

# claude sets CLAUDECODE in its env -- child CLIs see it and refuse to run.
unset CLAUDECODE

# load BETTER_AUTH_SECRET from .env.local in local development only if not set
if [[ -z "${BETTER_AUTH_SECRET:-}" && "${NODE_ENV:-development}" != "production" && -f "$MENTIKO_ROOT/web/.env.local" ]]; then
  BETTER_AUTH_SECRET=$(grep '^BETTER_AUTH_SECRET=' "$MENTIKO_ROOT/web/.env.local" | cut -d= -f2-)
  export BETTER_AUTH_SECRET
fi

# ─── args ───

TASK=""
WATCH_MODE="false"
PROFILE_ID=""
MAX_ROUNDS="${PEER_MAX_ROUNDS:-0}"
MANAGER_SESSION=""
PEER1_NAME=""
PEER2_NAME=""
CUSTOM_PROMPT_1=""
CUSTOM_PROMPT_2=""
STALL_THRESHOLD="${PEER_STALL_THRESHOLD:-0}"
RESUME_MEETING=""
RELAY_MODEL_OVERRIDE=""
RELAY_PROFILE_OVERRIDE=""
PROFILE1_OVERRIDE=""
PROFILE2_OVERRIDE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --watch)   WATCH_MODE="true"; shift ;;
    --profile) PROFILE_ID="${2:-}"; shift 2 ;;
    --rounds)  MAX_ROUNDS="${2:-20}"; shift 2 ;;
    --session) MANAGER_SESSION="${2:-}"; shift 2 ;;
    --name1)   PEER1_NAME="${2:-peer-1}"; shift 2 ;;
    --name2)   PEER2_NAME="${2:-peer-2}"; shift 2 ;;
    --prompt1) CUSTOM_PROMPT_1="${2:-}"; shift 2 ;;
    --prompt2) CUSTOM_PROMPT_2="${2:-}"; shift 2 ;;
    --profile1) PROFILE1_OVERRIDE="${2:-}"; shift 2 ;;
    --profile2) PROFILE2_OVERRIDE="${2:-}"; shift 2 ;;
    --stall-threshold) STALL_THRESHOLD="${2:-15}"; shift 2 ;;
    --relay-model) RELAY_MODEL_OVERRIDE="${2:-}"; shift 2 ;;
    --relay-profile) RELAY_PROFILE_OVERRIDE="${2:-}"; shift 2 ;;
    --resume)  RESUME_MEETING="${2:-}"; shift 2 ;;
    --help)
      echo "  usage: peer-manager <task> [--profile <id>] [--rounds N] [--session <id>] [--watch]"
      echo "         peer-manager --resume <meeting-id>"
      exit 0 ;;
    *) TASK="${TASK:-$1}"; shift ;;
  esac
done

if [[ -z "$TASK" && -z "$RESUME_MEETING" ]]; then
  echo "  error: task required (or --resume <meeting-id>)"
  exit 1
fi

# ─── profile ───

PROFILE_ID="${PROFILE_ID:-$(find_default_profile)}"
[[ -z "$PROFILE_ID" ]] && { echo "  error: no agent profile found"; exit 1; }
_safe_profile_id "$PROFILE_ID" || { echo "  error: invalid profile id"; exit 1; }

PROFILE_FILE="${AGENT_PROFILES_DIR:-$MENTIKO_ORG_ROOT/agent-profiles}/${PROFILE_ID}.json"
[[ ! -f "$PROFILE_FILE" ]] && { echo "  error: profile '$PROFILE_ID' not found"; exit 1; }

# per-agent profile overrides (--profile1, --profile2)
PROFILE_FILE_1="$PROFILE_FILE"
PROFILE_FILE_2="$PROFILE_FILE"
if [[ -n "$PROFILE1_OVERRIDE" ]]; then
  if ! _safe_profile_id "$PROFILE1_OVERRIDE"; then
    log "warning: invalid profile '$PROFILE1_OVERRIDE' for agent 1, using default"
  else
  _p1="${AGENT_PROFILES_DIR:-$MENTIKO_ORG_ROOT/agent-profiles}/${PROFILE1_OVERRIDE}.json"
  if [[ -f "$_p1" ]]; then
    PROFILE_FILE_1="$_p1"
    log "agent 1 profile override: $PROFILE1_OVERRIDE"
  else
    log "warning: profile '$PROFILE1_OVERRIDE' not found for agent 1, using default"
  fi
  fi
fi
if [[ -n "$PROFILE2_OVERRIDE" ]]; then
  if ! _safe_profile_id "$PROFILE2_OVERRIDE"; then
    log "warning: invalid profile '$PROFILE2_OVERRIDE' for agent 2, using default"
  else
  _p2="${AGENT_PROFILES_DIR:-$MENTIKO_ORG_ROOT/agent-profiles}/${PROFILE2_OVERRIDE}.json"
  if [[ -f "$_p2" ]]; then
    PROFILE_FILE_2="$_p2"
    log "agent 2 profile override: $PROFILE2_OVERRIDE"
  else
    log "warning: profile '$PROFILE2_OVERRIDE' not found for agent 2, using default"
  fi
  fi
fi

CLI_CMD_1=$(build_profile_command "$PROFILE_FILE_1" --interactive)
CLI_CMD_2=$(build_profile_command "$PROFILE_FILE_2" --interactive)
PROFILE_NAME=$(jq -r '.name // .id' "$PROFILE_FILE")

# relay config (for capture_and_clean pipe)
# if --relay-profile was passed, use that profile for relay instead of the agent profile
RELAY_PROFILE_FILE="$PROFILE_FILE"
if [[ -n "$RELAY_PROFILE_OVERRIDE" ]]; then
  if ! _safe_profile_id "$RELAY_PROFILE_OVERRIDE"; then
    log "warning: invalid relay profile '$RELAY_PROFILE_OVERRIDE', using default"
  else
  _rp="${AGENT_PROFILES_DIR:-$MENTIKO_ORG_ROOT/agent-profiles}/${RELAY_PROFILE_OVERRIDE}.json"
  if [[ -f "$_rp" ]]; then
    RELAY_PROFILE_FILE="$_rp"
    log "using relay profile override: $RELAY_PROFILE_OVERRIDE"
  else
    log "warning: relay profile '$RELAY_PROFILE_OVERRIDE' not found, using default"
  fi
  fi
fi

RELAY_CLI=$(jq -r '.cli // "claude"' "$RELAY_PROFILE_FILE")
RELAY_PIPE_FLAG=$(jq -r '.pipe_flag // "-p"' "$RELAY_PROFILE_FILE")
RELAY_MODEL=$(jq -r '.relay_model // .model // "haiku"' "$RELAY_PROFILE_FILE")
[[ -n "$RELAY_MODEL_OVERRIDE" ]] && RELAY_MODEL="$RELAY_MODEL_OVERRIDE"
RELAY_PRE_EXEC=$(jq -r '.pre_exec // empty' "$RELAY_PROFILE_FILE")

RELAY_ENV_FILE=""
_has_env=$(jq -r '.env // {} | length' "$RELAY_PROFILE_FILE" 2>/dev/null || echo "0")
if [[ "$_has_env" -gt 0 ]]; then
  RELAY_ENV_FILE=$(mktemp /tmp/relay-env-XXXXXX)
  chmod 600 "$RELAY_ENV_FILE"
  _resolve="$MENTIKO_CODE_ROOT/bin/secrets-resolve.mjs"
  if [[ -f "$_resolve" ]]; then
    node "$_resolve" "${NAMESPACE_ID:-default}" "${ORG_ID:-default}" "$RELAY_PROFILE_FILE" > "$RELAY_ENV_FILE" 2>/dev/null || \
    jq -r '.env // {} | to_entries[] | "export " + .key + "=" + (.value | @sh)' "$RELAY_PROFILE_FILE" > "$RELAY_ENV_FILE" 2>/dev/null
  else
    jq -r '.env // {} | to_entries[] | "export " + .key + "=" + (.value | @sh)' "$RELAY_PROFILE_FILE" > "$RELAY_ENV_FILE" 2>/dev/null
  fi
fi

# ─── peer names ───

sanitize_name() { echo "$1" | sed 's/[^a-zA-Z0-9._-]/-/g'; }

PEER1_NAME=$(sanitize_name "${PEER1_NAME:-peer-1}")
PEER2_NAME=$(sanitize_name "${PEER2_NAME:-peer-2}")

ID=$(date +%Y%m%d-%H%M%S)
PEER1="${PEER1_NAME}-${ID}"
PEER2="${PEER2_NAME}-${ID}"
WORK_DIR="${PEER_WORK_DIR:-$MENTIKO_ROOT}"

echo "  task:    $TASK"
echo "  profile: $PROFILE_NAME ($PROFILE_ID)"
echo "  peer-1:  $PEER1"
echo "  peer-2:  $PEER2"
echo "{\"peer1\":\"$PEER1\",\"peer2\":\"$PEER2\"}"

# ─── state ───

STATUS_FILE=$(mktemp /tmp/peer-manager-status.XXXXXX)
PEER_OUTPUT_DIR="$NAMESPACE_ROOT/peer-output"
mkdir -p "$PEER_OUTPUT_DIR" 2>/dev/null || true

ESCALATION_DIR="$NAMESPACE_ROOT/peer-escalations/${MANAGER_SESSION:-peer-unknown}"
REPLY_FILE="$ESCALATION_DIR/reply.txt"
MEETING_FILE="$ESCALATION_DIR/meeting.json"
mkdir -p "$ESCALATION_DIR"

ESC_COUNT=0
CONSECUTIVE_CONTINUES=0
LAST_ESC_ROUND=0
ESC_GOT_REPLY=false
STEER_MESSAGE=""

PEER1_JSONL=""
PEER2_JSONL=""

# ─── typed run-record boundaries ───

start_peer_run_record() {
  [[ -z "${LINK_RUN_ID:-}" ]] && return 0
  _run_record_cli peer-start \
    --runs-dir "${RUNS_DIR:?RUNS_DIR must be configured}" \
    --run-id "$LINK_RUN_ID" \
    --first-session "$PEER1" \
    --second-session "$PEER2" >/dev/null
}

complete_peer_run_record() {
  local rounds="$1"
  [[ -z "${LINK_RUN_ID:-}" ]] && return 0
  _run_record_cli peer-complete \
    --runs-dir "${RUNS_DIR:?RUNS_DIR must be configured}" \
    --run-id "$LINK_RUN_ID" \
    --rounds "$rounds" >/dev/null
}

# ─── session helpers ───

wait_for_stable() {
  local session="$1" threshold="${2:-4}" interval="${3:-2}"
  local stable=0 last_hash=""

  while true; do
    "$P" alive "$session" >/dev/null 2>&1 || { log "$session died"; return 1; }

    local hash
    hash=$("$P" capture "$session" 200 2>/dev/null | _md5)

    if [[ "$hash" == "$last_hash" ]]; then
      stable=$((stable + 1))
    else
      stable=0
      last_hash="$hash"
    fi

    [[ $stable -ge $threshold ]] && return 0
    sleep "$interval"
  done
}

wait_for_cli_with_baseline() {
  local session="$1" baseline="$2" max_wait=60 elapsed=0

  while [[ $elapsed -lt $max_wait ]]; do
    local current
    current=$("$P" capture "$session" 10 2>/dev/null | _md5)
    if [[ "$current" != "$baseline" ]]; then
      log "$session CLI detected, waiting for input prompt..."
      sleep 3
      wait_for_stable "$session" 3 2 || return 1
      return 0
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  log "warning: $session CLI not detected after ${max_wait}s"
  return 1
}

# ─── output persistence ───

persist_output() {
  local session="$1" round="$2" content="$3"
  local outfile="$PEER_OUTPUT_DIR/${session}-r${round}-$(date +%s).txt"
  echo "$content" > "$outfile"
  log "persisted: $(basename "$outfile") ($(echo "$content" | wc -c | tr -d ' ') bytes)"
}

# ─── JSONL helpers ───

resolve_peer_jsonl() {
  local session="$1"
  local log_dir
  log_dir=$(resolve_log_dir "$PROFILE_FILE" "${PEER_WORK_DIR:-$MENTIKO_ROOT}")
  [[ -z "$log_dir" || ! -d "$log_dir" ]] && { echo ""; return; }
  resolve_session_log "$log_dir" "$session" "$P"
}

get_session_jsonl() {
  local session="$1"
  if [[ "$session" == "$PEER1" && -n "$PEER1_JSONL" ]]; then echo "$PEER1_JSONL"
  elif [[ "$session" == "$PEER2" && -n "$PEER2_JSONL" ]]; then echo "$PEER2_JSONL"
  else echo ""
  fi
}

extract_last_response() {
  local jsonl="$1"
  python3 -c "
import json
last_text = ''
with open('$jsonl') as f:
    for line in f:
        try:
            d = json.loads(line.strip())
            if d.get('type') == 'assistant':
                texts = [c['text'] for c in d.get('message',{}).get('content',[])
                         if isinstance(c,dict) and c.get('type')=='text' and c.get('text','').strip()]
                if texts: last_text = '\n'.join(texts)
        except: pass
print(last_text)
" 2>/dev/null
}

# ─── meeting metadata ───

save_meeting_meta() {
  local round="${1:-0}"
  local p1c="${2:-}" p2c="${3:-}"

  [[ -z "$p1c" && -n "$PEER1_JSONL" ]] && p1c=$(basename "$PEER1_JSONL" .jsonl)
  [[ -z "$p2c" && -n "$PEER2_JSONL" ]] && p2c=$(basename "$PEER2_JSONL" .jsonl)

  cat > "$MEETING_FILE" <<EOF
{
  "id": "$(echo "$PEER1" | grep -o '[0-9]\{8\}-[0-9]\{6\}' || echo "$MANAGER_SESSION")",
  "task": $(echo "$TASK" | _json_escape),
  "peer1": { "pty": "$PEER1", "claude": "$p1c" },
  "peer2": { "pty": "$PEER2", "claude": "$p2c" },
  "round": $round,
  "startedAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "managerSession": "${MANAGER_SESSION:-}"
}
EOF
  log "meeting metadata saved"
}

# ─── capture and relay ───

capture_and_clean() {
  local session="$1" round="$2"

  # determine speaker/listener
  local speaker listener speaker_role listener_role
  if [[ "$session" == "$PEER1" ]]; then
    speaker="$PEER1_NAME" listener="$PEER2_NAME"
    speaker_role="${CUSTOM_PROMPT_1:+Role: $CUSTOM_PROMPT_1}"
    listener_role="${CUSTOM_PROMPT_2:+Role: $CUSTOM_PROMPT_2}"
  else
    speaker="$PEER2_NAME" listener="$PEER1_NAME"
    speaker_role="${CUSTOM_PROMPT_2:+Role: $CUSTOM_PROMPT_2}"
    listener_role="${CUSTOM_PROMPT_1:+Role: $CUSTOM_PROMPT_1}"
  fi

  # capture terminal output to temp file (never in a shell variable -- no expansion risk)
  local tmp_input=$(mktemp /tmp/peer-input-XXXXXX)
  "$P" capture "$session" 600 > "$tmp_input" 2>/dev/null

  # combine relay instructions + raw capture as single stdin (matches job-runner.mjs pattern)
  local tmp_full=$(mktemp /tmp/peer-full-XXXXXX)
  {
    cat <<'RELAY'
You are relaying messages between two AI agents who are collaborating
on a project. They do not know they are talking to AI -- they think a
human project lead is passing messages between them. You must maintain
this illusion.

Below is a terminal capture from one agent's session. Your job:

1. Read the terminal output and find the agent's most recent response.
   Ignore all terminal chrome (prompt lines, status bars, ANSI codes,
   tool call output, thinking indicators, file contents from Read/cat).
   Focus on what the agent SAID, not what tools it ran.

2. Rewrite their response in first person, as if you are a human
   project lead paraphrasing what this agent found/decided/built.
   Keep it direct and natural. No headers, no labels, no "FROM:",
   no role names. Just talk like a person passing along information.

3. Preserve ALL substance: findings, decisions, code references,
   questions, action items, analysis. Do not summarize or shorten.
   Up to 1000 words is fine. Keep their structure (bullets, lists,
   paragraphs) but strip any AI-isms like "I'd be happy to" or
   "Certainly!".

4. If the agent asked questions, include those questions so the other
   agent can answer them.

5. If the terminal capture shows the agent is still running tool calls
   with no text response yet, write: "still working on it, give them
   a minute" and nothing else.

EXAMPLES:

Terminal shows agent analyzed a codebase:
  "looked through the whole codebase. here's what i found:
   - auth is solid, nextauth v5 with timing protection
   - 17 tables in the schema, well designed
   - no tests though, just one smoke test
   - mobile app is scaffolded but screens are placeholder
   - stripe integration works but crypto payments are unclear
   couple questions: are the crypto routes actually used or dead code?
   and should we commit the uncommitted auth fixes first?"

Terminal shows agent made code changes:
  "fixed the proxy middleware and removed the dead /admin routes from
   the web app. build passes clean now. also committed the security
   fixes that were sitting uncommitted.
   ready to move on to setting up the production database."
 
Your personality:
- Direct, no bullshit. Never say "Great job!" or "I notice that..."
- Short sentences. 1-2 lines max. Sometimes one word is enough.
- You don't explain WHY they should do something. Just tell them WHAT.
- You prioritize velocity over perfection.
- If something is blocked, skip it and move to the next thing.
- If something works, don't touch it. Move on.
- Never recap what the agent did. Only forward-looking directives.
- You care about: build passing, design consistency, shipping features.

 
LAST LINE RULE:
Your very last line must be exactly STATUS:DONE or STATUS:CONTINUE
- STATUS:DONE = the agent has explicitly stated they are finished,
  the collaboration is complete, there is nothing left to do. this
  is rare. only use it when the agent clearly says "done" or "complete"
  or "finished" with no follow-up questions or next steps.
- STATUS:CONTINUE = everything else. the agent shared findings,
  asked questions, made progress, is still working, or there is
  any remaining work. this is the default.
  
  It is critical you keep the conversation going. 

--- TERMINAL CAPTURE ---

RELAY
    cat "$tmp_input"
    
    
  } > "$tmp_full"

  # source profile env vars + pre_exec, then pipe everything via stdin (no positional arg)
  local _setup="unset CLAUDECODE; "
  [[ -n "$RELAY_ENV_FILE" && -f "$RELAY_ENV_FILE" ]] && _setup+="set -a; source '$RELAY_ENV_FILE'; set +a; "
  [[ -n "$RELAY_PRE_EXEC" ]] && _setup+="$RELAY_PRE_EXEC; "

  local result
  result=$(bash -c "${_setup}exec \"\$@\"" _ \
    "$RELAY_CLI" $RELAY_PIPE_FLAG --model "$RELAY_MODEL" \
    < "$tmp_full" 2>/dev/null) || result=""
  rm -f "$tmp_input" "$tmp_full"

  if [[ -z "$result" ]]; then
    log "ERROR: relay pipe failed for $session round $round. skipping this turn."
    echo "CONTINUE" > "$STATUS_FILE"
    echo "[relay failed - no message delivered this round]"
    return
  fi

  # extract status from last line
  local last_line
  last_line=$(echo "$result" | tail -1)
  if echo "$last_line" | grep -q '^STATUS:DONE'; then
    echo "DONE" > "$STATUS_FILE"
  elif echo "$last_line" | grep -q '^STATUS:ESCALATE'; then
    echo "ESCALATE" > "$STATUS_FILE"
  else
    echo "CONTINUE" > "$STATUS_FILE"
  fi
  echo "$result" | grep -v '^STATUS:'
}

send_to_peer() {
  local target="$1" message="$2"
  transport_send_keys "$target" "$message"
}

# ─── escalation ───

fire_escalation() {
  local round="$1" consecutive="$2" last_output="$3" trigger="$4"

  # anti-spam: skip if we just escalated within 3 rounds
  if [[ $((round - LAST_ESC_ROUND)) -lt 3 && $LAST_ESC_ROUND -gt 0 ]]; then
    log "escalation suppressed (too soon after round $LAST_ESC_ROUND)"
    return
  fi

  ESC_COUNT=$((ESC_COUNT + 1))
  LAST_ESC_ROUND=$round
  log "escalation $ESC_COUNT triggered (round=$round trigger=$trigger)"
  _sys_log "warn" "peer-manager" "escalation triggered: $trigger" "run: ${LINK_RUN_ID:-unknown}, round: $round, esc_count: $ESC_COUNT, consecutive: $consecutive"

  # get last raw output from each peer
  local p1_raw p2_raw
  p1_raw=$(tail -20 "$(ls -t "$PEER_OUTPUT_DIR/${PEER1}-"*.txt 2>/dev/null | head -1)" 2>/dev/null || echo "unavailable")
  p2_raw=$(tail -20 "$(ls -t "$PEER_OUTPUT_DIR/${PEER2}-"*.txt 2>/dev/null | head -1)" 2>/dev/null || echo "unavailable")

  local payload
  payload=$(jq -n \
    --arg session "${MANAGER_SESSION:-}" \
    --arg esc_id "esc-${ESC_COUNT}" \
    --argjson round "$round" \
    --arg trigger "$trigger" \
    --argjson consecutive "$consecutive" \
    --arg peer1_last "$p1_raw" \
    --arg peer2_last "$p2_raw" \
    '{session_id: $session, escalation_id: $esc_id, round: $round,
      trigger: $trigger, consecutive_continues: $consecutive,
      peer1_last: $peer1_last, peer2_last: $peer2_last}')

  local curl_args=(
    -s
    -X POST
    "http://localhost:${WEB_PORT:-3000}/api/links/runs/${LINK_RUN_ID:-unknown}/escalate"
    -H "content-type: application/json"
  )
  if [[ -n "${BETTER_AUTH_SECRET:-}" ]]; then
    curl_args+=(
      -H "authorization: Bearer ${BETTER_AUTH_SECRET}"
      -H "x-namespace-id: ${NAMESPACE_ID:-default}"
      -H "x-org-id: ${ORG_ID:-default}"
    )
  fi
  curl "${curl_args[@]}" -d "$payload" >/dev/null 2>&1 || log "warning: escalation API call failed"

  # block waiting for human reply (poll every 5s, 1hr timeout)
  log "waiting for human reply (file: $REPLY_FILE)..."
  local wait=0
  while [[ ! -f "$REPLY_FILE" && $wait -lt 3600 ]]; do
    sleep 5
    wait=$((wait + 5))
  done

  if [[ ! -f "$REPLY_FILE" ]]; then
    log "escalation timeout — resuming without human input"
    ESC_GOT_REPLY=false
    return
  fi

  local reply
  reply=$(cat "$REPLY_FILE")
  rm -f "$REPLY_FILE"
  ESC_GOT_REPLY=true

  local reply_lower
  reply_lower=$(echo "$reply" | tr '[:upper:]' '[:lower:]' | xargs)
  if [[ "$reply_lower" == "continue" || "$reply_lower" == "c" || "$reply_lower" == "go" ]]; then
    log "human said continue — resuming"
    STEER_MESSAGE=""
  else
    log "steering next relay: ${reply:0:80}..."
    STEER_MESSAGE="$reply"
  fi
}

# ─── peer turn (DRY: handles either peer) ───

# process one peer's turn: wait, capture, check status, handle escalation/steer
# args: $1=session $2=round
# sets: OUTPUT, PEER_STATUS
process_peer_turn() {
  local session="$1" round="$2"
  local name
  [[ "$session" == "$PEER1" ]] && name="peer-1" || name="peer-2"

  log "round $round: waiting for $name..."
  wait_for_stable "$session" 4 2 || { log "$name died"; return 1; }

  log "round $round: capturing $name..."
  OUTPUT=$(capture_and_clean "$session" "$round")
  persist_output "$session" "$round" "$OUTPUT"
  PEER_STATUS=$(cat "$STATUS_FILE")

  case "$PEER_STATUS" in
    ESCALATE)
      log "round $round: $name signals ESCALATE"
      fire_escalation "$round" "$CONSECUTIVE_CONTINUES" "$OUTPUT" "STATUS:ESCALATE"
      CONSECUTIVE_CONTINUES=0
      ;;
    CONTINUE)
      CONSECUTIVE_CONTINUES=$((CONSECUTIVE_CONTINUES + 1))
      if [[ $STALL_THRESHOLD -gt 0 && $CONSECUTIVE_CONTINUES -ge $STALL_THRESHOLD ]]; then
        log "round $round: stall detected ($CONSECUTIVE_CONTINUES continues, threshold=$STALL_THRESHOLD)"
        fire_escalation "$round" "$CONSECUTIVE_CONTINUES" "$OUTPUT" "STALL"
        CONSECUTIVE_CONTINUES=0
      fi
      ;;
    DONE)
      CONSECUTIVE_CONTINUES=0
      log "round $round: $name signals DONE"
      ;;
  esac
}

# check for steer message from UI (reply.txt written outside of escalation)
check_steer() {
  [[ -n "$STEER_MESSAGE" ]] && return
  [[ ! -f "$REPLY_FILE" ]] && return

  local ui_steer
  ui_steer=$(cat "$REPLY_FILE")
  rm -f "$REPLY_FILE"

  local ui_lower
  ui_lower=$(echo "$ui_steer" | tr '[:upper:]' '[:lower:]' | xargs)
  if [[ "$ui_lower" != "continue" && "$ui_lower" != "c" && "$ui_lower" != "go" ]]; then
    STEER_MESSAGE="$ui_steer"
    log "steer from UI: ${ui_steer:0:80}..."
  fi
}

# relay captured output to the other peer, with optional steer message
relay_to() {
  local target="$1" round="$2"
  local msg="$OUTPUT"
  if [[ -n "$STEER_MESSAGE" ]]; then
    msg="${OUTPUT}

Also, one more thing: ${STEER_MESSAGE}"
    STEER_MESSAGE=""
  fi

  local target_name
  [[ "$target" == "$PEER1" ]] && target_name="peer-1" || target_name="peer-2"
  local source_name
  [[ "$target" == "$PEER1" ]] && source_name="peer-2" || source_name="peer-1"

  log "round $round: $source_name → $target_name"
  _sys_log "info" "peer-manager" "relay: $source_name -> $target_name" "run: ${LINK_RUN_ID:-unknown}, round: $round, msg_len: ${#msg}"
  send_to_peer "$target" "$msg"
}

# ─── cleanup ───

cleanup() {
  log "shutting down..."
  _sys_log "info" "peer-manager" "cleaning up sessions" "run: ${LINK_RUN_ID:-unknown}, peer1: ${PEER1:-unknown}, peer2: ${PEER2:-unknown}"
  "$P" remove "$PEER1" 2>/dev/null || true
  "$P" remove "$PEER2" 2>/dev/null || true
  rm -f "$STATUS_FILE" "$RELAY_ENV_FILE" 2>/dev/null || true
  exit 0
}
trap cleanup INT TERM

# ─── spawn peers ───

spawn_peer() {
  local name="$1" cli_cmd="$2"
  log "spawning $name..."
  local out
  out=$("$P" spawn "$name" 2>&1) || log "spawn $name FAILED: $out"
  log "spawn $name: $out"
  sleep 1

  # snapshot screen before CLI command
  local baseline
  baseline=$("$P" capture "$name" 10 2>/dev/null | _md5)
  echo "$baseline"
}

boot_cli() {
  local name="$1" cli_cmd="$2" baseline="$3"
  log "starting CLI for $name... (cwd: $WORK_DIR)"
  transport_send_keys "$name" "cd $(_shell_quote "$WORK_DIR") && $cli_cmd"
  sleep 2
  wait_for_cli_with_baseline "$name" "$baseline" || { log "error: $name CLI failed"; cleanup; }
}

# ─── init transport ───

log "starting daemon if needed..."
transport_init || { log "error: pty-manager daemon failed"; exit 1; }

# ─── resume mode ───

if [[ -n "$RESUME_MEETING" ]]; then
  RESUME_DIR="$NAMESPACE_ROOT/peer-escalations/$RESUME_MEETING"
  if [[ ! -f "$RESUME_DIR/meeting.json" ]]; then
    for d in "$NAMESPACE_ROOT/peer-escalations/"*; do
      if [[ -f "$d/meeting.json" ]]; then
        mid=$(cat "$d/meeting.json" | _json_get id "")
        [[ "$mid" == "$RESUME_MEETING" ]] && { RESUME_DIR="$d"; break; }
      fi
    done
  fi

  [[ ! -f "$RESUME_DIR/meeting.json" ]] && { echo "  error: meeting '$RESUME_MEETING' not found"; exit 1; }

  MEETING_META=$(cat "$RESUME_DIR/meeting.json")
  TASK=$(echo "$MEETING_META" | _json_get task "resumed meeting")
  PEER1_CLAUDE=$(echo "$MEETING_META" | python3 -c "import json,sys; print(json.load(sys.stdin)['peer1']['claude'])" 2>/dev/null)
  PEER2_CLAUDE=$(echo "$MEETING_META" | python3 -c "import json,sys; print(json.load(sys.stdin)['peer2']['claude'])" 2>/dev/null)
  RESUME_ROUND=$(echo "$MEETING_META" | _json_get round 0)

  [[ -z "$PEER1_CLAUDE" || -z "$PEER2_CLAUDE" ]] && { echo "  error: meeting metadata missing CLI session IDs"; exit 1; }

  log "resuming meeting: $RESUME_MEETING (round $RESUME_ROUND)"

  TIMESTAMP=$(date +%Y%m%d-%H%M%S)
  PEER1="${PEER1_NAME}-${TIMESTAMP}"
  PEER2="${PEER2_NAME}-${TIMESTAMP}"

  ESCALATION_DIR="$NAMESPACE_ROOT/peer-escalations/${MANAGER_SESSION:-$PEER1}"
  REPLY_FILE="$ESCALATION_DIR/reply.txt"
  MEETING_FILE="$ESCALATION_DIR/meeting.json"
  mkdir -p "$ESCALATION_DIR"

  "$P" config screen 120x50 >/dev/null 2>&1
  "$P" spawn "$PEER1" >/dev/null 2>&1; sleep 1
  "$P" spawn "$PEER2" >/dev/null 2>&1; sleep 1

  BASELINE_1=$("$P" capture "$PEER1" 10 2>/dev/null | _md5)
  BASELINE_2=$("$P" capture "$PEER2" 10 2>/dev/null | _md5)

  log "resuming peer-1 session..."
  transport_send_keys "$PEER1" "cd $(_shell_quote "$WORK_DIR") && $CLI_CMD_1 --resume $PEER1_CLAUDE"
  sleep 1
  log "resuming peer-2 session..."
  transport_send_keys "$PEER2" "cd $(_shell_quote "$WORK_DIR") && $CLI_CMD_2 --resume $PEER2_CLAUDE"
  sleep 1

  wait_for_cli_with_baseline "$PEER1" "$BASELINE_1" || { log "error: peer-1 resume failed"; cleanup; }
  wait_for_cli_with_baseline "$PEER2" "$BASELINE_2" || { log "error: peer-2 resume failed"; cleanup; }
  log "both CLIs resumed"

  _base_path=$(resolve_log_dir "$PROFILE_FILE" "$WORK_DIR")
  PEER1_JSONL="$_base_path/${PEER1_CLAUDE}.jsonl"
  PEER2_JSONL="$_base_path/${PEER2_CLAUDE}.jsonl"
  save_meeting_meta "$RESUME_ROUND"

  transport_send_keys "$PEER1" "continue where you left off"
  sleep 2
  round=$RESUME_ROUND
  log "entering relay loop from round $round..."

else
  # ─── fresh start ───

  # update run.json with peer session names
  start_peer_run_record || { log "typed peer run start failed"; exit 1; }

  "$P" config screen 120x50 >/dev/null 2>&1
  BASELINE_1=$(spawn_peer "$PEER1" "$CLI_CMD_1")
  BASELINE_2=$(spawn_peer "$PEER2" "$CLI_CMD_2")

  # write activity capture prereqs
  if [[ -n "${LINK_RUN_ID:-}" ]]; then
    _art_dir="${RUNS_DIR:-${MENTIKO_PROJECT_ROOT:-$NAMESPACE_ROOT}/runs}/${LINK_RUN_ID}/artifacts"
    mkdir -p "$_art_dir"
    _sha=$(git -C "$WORK_DIR" rev-parse HEAD 2>/dev/null || echo "")
    _now=$(date -u +"%Y-%m-%dT%H:%M:%S")
    for agent in agent1 agent2; do
      echo "$_sha" > "$_art_dir/${agent}-git-before.txt"
      echo "$_now" > "$_art_dir/${agent}-started-at.txt"
    done
    log "activity prereqs written (sha: ${_sha:0:8})"
  fi

  boot_cli "$PEER1" "$CLI_CMD_1" "$BASELINE_1"
  boot_cli "$PEER2" "$CLI_CMD_2" "$BASELINE_2"
  log "both CLIs ready"
  _sys_log "info" "peer-manager" "link run started" "run: ${LINK_RUN_ID:-unknown}, peer1: $PEER1, peer2: $PEER2, task: ${TASK:0:80}"

  # ─── send initial prompts ───

  PROMPT_1="${CUSTOM_PROMPT_1:-$TASK}"
  log "sending prompt to peer-1..."
  transport_send_keys "$PEER1" "$PROMPT_1"
  sleep 2

  if [[ -n "$CUSTOM_PROMPT_2" ]]; then
    log "sending role prompt to peer-2..."
    transport_send_keys "$PEER2" "$CUSTOM_PROMPT_2"
    sleep 2
    wait_for_stable "$PEER2" 4 2 || { log "error: peer-2 died during role setup"; cleanup; }
    log "peer-2 role briefing done"
  fi

  # ─── kickoff: peer-1 responds, relay to peer-2 ───

  log "waiting for peer-1 to respond..."
  wait_for_stable "$PEER1" 4 2 || { log "error: peer-1 died"; cleanup; }

  log "capturing peer-1 response..."
  KICKOFF=$(capture_and_clean "$PEER1" 0)
  persist_output "$PEER1" 0 "$KICKOFF"
  log "sending peer-1 response → peer-2"
  send_to_peer "$PEER2" "$KICKOFF"

  PEER1_JSONL=$(resolve_peer_jsonl "$PEER1" "$PROMPT_1")
  PEER2_JSONL=$(resolve_peer_jsonl "$PEER2" "${CUSTOM_PROMPT_2:-$KICKOFF}")
  save_meeting_meta 0
  log "peer-1 session: $(basename "${PEER1_JSONL:--}" .jsonl)"
  log "peer-2 session: $(basename "${PEER2_JSONL:--}" .jsonl)"

  # ─── peer-2 responds to kickoff ───

  log "waiting for peer-2 kickoff response..."
  wait_for_stable "$PEER2" 4 2 || { log "error: peer-2 died during kickoff"; cleanup; }

  KICKOFF_REPLY=$(capture_and_clean "$PEER2" 0)
  persist_output "$PEER2" 0 "$KICKOFF_REPLY"
  log "sending peer-2 kickoff → peer-1"
  send_to_peer "$PEER1" "$KICKOFF_REPLY"

  round=0
fi

# ─── main relay loop ───

peer1_done=false
peer2_done=false

while true; do
  # max rounds check
  if [[ $MAX_ROUNDS -gt 0 && $round -ge $MAX_ROUNDS ]]; then
    log "hit max rounds ($MAX_ROUNDS) — escalating"
    ESC_GOT_REPLY=false
    fire_escalation "$round" "$CONSECUTIVE_CONTINUES" "" "MAX_ROUNDS"
    CONSECUTIVE_CONTINUES=0
    if [[ "$ESC_GOT_REPLY" == "true" ]]; then
      MAX_ROUNDS=$((MAX_ROUNDS + 10))
      log "extending to $MAX_ROUNDS rounds"
    else
      break
    fi
  fi

  round=$((round + 1))
  save_meeting_meta "$round"

  # peer-1 turn
  process_peer_turn "$PEER1" "$round" || break
  peer1_done="$PEER_STATUS"
  check_steer
  relay_to "$PEER2" "$round"

  # peer-2 turn
  process_peer_turn "$PEER2" "$round" || break
  peer2_done="$PEER_STATUS"

  # both done = complete
  [[ "$peer1_done" == "DONE" && "$peer2_done" == "DONE" ]] && {
    log "both peers signal DONE after $round rounds"
    break
  }

  check_steer
  relay_to "$PEER1" "$round"
done

log "completed $round rounds"
_sys_log "info" "peer-manager" "link run completed: ${LINK_RUN_ID:-unknown}" "rounds: $round, peer1: $PEER1, peer2: $PEER2"

# ─── completion ───

complete_peer_run_record "$round" || { log "typed peer run completion failed"; exit 1; }

# capture agent activity
if [[ -n "${LINK_RUN_ID:-}" ]]; then
  _run_dir="${RUNS_DIR:-${MENTIKO_PROJECT_ROOT:-$NAMESPACE_ROOT}/runs}/${LINK_RUN_ID}"
  _art_dir="$_run_dir/artifacts"
  mkdir -p "$_art_dir"

  cat "$PEER_OUTPUT_DIR/${PEER1}-r"*.txt > "$_art_dir/agent1-output.txt" 2>/dev/null || true
  cat "$PEER_OUTPUT_DIR/${PEER2}-r"*.txt > "$_art_dir/agent2-output.txt" 2>/dev/null || true

  log "capturing agent activity..."
  source "$SCRIPT_DIR/../lib/agent-activity-capture.sh" 2>/dev/null || true
  for i in 1 2; do
    capture-agent-activity "agent${i}" "$LINK_RUN_ID" "$WORK_DIR" \
      "$_art_dir/agent${i}-output.txt" "${NAMESPACE_ID:-default}" "$PROFILE_FILE" \
      2>/dev/null || log "agent${i} activity capture failed"
  done
  log "artifacts captured"
fi

log "cleaning up peer sessions..."
"$P" remove "$PEER1" >/dev/null 2>&1
"$P" remove "$PEER2" >/dev/null 2>&1
rm -f "$STATUS_FILE" "$RELAY_ENV_FILE" 2>/dev/null || true
log "done"
