#!/bin/bash
# peer-watch - watch session for screen stabilization, then forward to peer

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export MENTIKO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/../lib/config.sh"

# cross-platform md5 (macOS md5 -q vs Linux md5sum)
_md5() { if command -v md5 >/dev/null 2>&1; then md5 -q; else md5sum | cut -d' ' -f1; fi; }

SESSION="${1:-}"
PEER="${2:-${CLAUDE_PEER:-}}"

if [[ -z "$SESSION" ]]; then
  echo "  usage: peer-watch <session> [peer]"
  exit 1
fi

if ! "$BIN_DIR/p" alive "$SESSION" >/dev/null 2>&1; then
  echo "  error: session '$SESSION' not found"
  exit 1
fi

STABLE_COUNT=0
STABLE_THRESHOLD=8
CHECK_INTERVAL=2
MIN_CYCLES=15
cycle_count=0
LAST_HASH=""
round=0
last_output=""

log() { echo "  [watch:$SESSION] $*"; }

log "monitoring..."
[[ -n "$PEER" ]] && log "will forward to: $PEER"

while true; do
  if ! "$BIN_DIR/p" alive "$SESSION" >/dev/null 2>&1; then
    log "session died"
    break
  fi

  CURRENT=$("$BIN_DIR/p" capture "$SESSION" 200 2>/dev/null || echo "")
  CURRENT_HASH=$(echo "$CURRENT" | _md5)

  cycle_count=$((cycle_count + 1))

  if [[ "$CURRENT_HASH" == "$LAST_HASH" ]]; then
    STABLE_COUNT=$((STABLE_COUNT + 1))
  else
    STABLE_COUNT=0
    LAST_HASH="$CURRENT_HASH"
  fi

  # activity detection: screen changed = active, stable = idle
  if [[ $STABLE_COUNT -eq 0 ]] && [[ "$last_output" != "active" ]]; then
    log "active (screen changing)"
    last_output="active"
  elif [[ $STABLE_COUNT -ge 3 ]] && [[ "$last_output" != "idle" ]]; then
    log "idle (screen stable)"
    last_output="idle"
  fi

  # show progress bar for stabilization
  if [[ $cycle_count -ge $MIN_CYCLES ]] && [[ $STABLE_COUNT -gt 0 ]]; then
    progress=$(((STABLE_COUNT * 100) / STABLE_THRESHOLD))
    if [[ $progress -lt 100 ]]; then
      printf "\r  [watch:$SESSION] stabilizing: [%-20s] %d%%" "$(head -c $((progress / 5)) /dev/zero | tr '\0' '=')" "$progress"
    fi
  fi

  if [[ $cycle_count -ge $MIN_CYCLES ]] && [[ $STABLE_COUNT -ge $STABLE_THRESHOLD ]]; then
    printf "\r"
    round=$((round + 1))
    log "✓ round $round: screen stabilized"

    OUTPUT="$CURRENT"

    OUTPUT_FILE="$NAMESPACE_ROOT/peer-output/${SESSION}-r${round}-$(date +%s).txt"
    mkdir -p "$(dirname "$OUTPUT_FILE")"
    echo "$OUTPUT" > "$OUTPUT_FILE"
    log "saved: $OUTPUT_FILE"

    if [[ -n "$PEER" ]]; then
      if "$BIN_DIR/p" alive "$PEER" >/dev/null 2>&1; then
        log "cleaning output via haiku..."

        CLEAN_PROMPT="You are a message relay between two AI agents collaborating on a task. Extract ONLY the agent's actual response from this terminal capture. Remove all terminal UI elements: status bars, token counts, permission prompts, bash prompts, escape sequences, tool call formatting, and any previous peer messages that were sent TO this agent. Return ONLY the agent's own words and any code/files they produced. No commentary from you."

        CLEANED=$(echo "$OUTPUT" | claude "$CLEAN_PROMPT" -p --model haiku 2>/dev/null) || CLEANED=""

        if [[ -z "$CLEANED" ]]; then
          log "cleanup failed, sending raw"
          CLEANED="$OUTPUT"
        fi

        log "forwarding to $PEER (round $round)..."

        FORMATTED="
━━━ peer message ━━━
from: $SESSION
round: $round
time: $(date -Iseconds)

$CLEANED
━━━━━━━━━━━━━━━━━━━━━━
"

        "$BIN_DIR/p" send "$PEER" "$FORMATTED"
        sleep 1
        "$BIN_DIR/p" send "$PEER" ""

        log "forwarded."
      else
        log "peer '$PEER' not found"
      fi
    fi

    cycle_count=0
    STABLE_COUNT=0
    sleep 5
  fi

  sleep $CHECK_INTERVAL
done

log "complete."
