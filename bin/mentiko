#!/bin/bash
# mentiko - CLI entry point
#
# usage:
#   mentiko auth [status|token|logout]
#   mentiko run <chain.json> [--workspace <path>] [--start <agent-id>] [--debug]
#   mentiko generate "<prompt>" [--output <dir>] [--template <file>] [--json] [--raw]
#   mentiko decision import <artifact.json> --decision <id> --phase <phase>
#   mentiko generation import <artifact.json> --job <id> --kind <kind>
#   mentiko launch <spec-file> [--monitor]
#   mentiko validate <chain.json> [--strict]
#   mentiko graph <chain.json>
#   mentiko peek <session-name> [lines]
#   mentiko send <session-name> "message"
#   mentiko kill <session-name>
#   mentiko kill-all
#   mentiko list
#   mentiko events [--unprocessed]
#   mentiko emit [--scope run|ingress] <event-name> [source] [data]
#   mentiko init [directory]
#   mentiko monitor <session-name> "end state" [profile] [interval]
#   mentiko audit [summary|export-json|export-csv|query|archive|clear]
#   mentiko seed

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/../lib"

# Set MENTIKO_ROOT to project root before sourcing config.sh.
# config.sh falls back to dirname of config.sh (= lib/) which puts
# namespaces at lib/namespaces/ instead of namespaces/.
export MENTIKO_ROOT="${MENTIKO_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"

# Load config
source "$LIB_DIR/config.sh"

# Load transport layer for pty-manager
source "$LIB_DIR/session-transport.sh"

CMD="${1:-help}"
shift || true

# Audit storage is owned by the typed audit CLI. This shell only submits the
# command fact before dispatching the requested external behavior.
node "$LIB_DIR/runner-audit.js" write \
    --namespace-id "$NAMESPACE_ID" \
    --event-type "cli_command" \
    --description "CLI command: $CMD" \
    --meta command="$CMD" --meta args="$*" \
    --source "cli" >/dev/null || true

case "$CMD" in

    # -------------------------------------------------------------------
    # JSON chain mode (new)
    # -------------------------------------------------------------------

    run)
        exec node "$LIB_DIR/mentiko-cli-run.mjs" "$@"
        ;;

    generate)
        bash "$LIB_DIR/chain-generator.sh" "$@"
        ;;

    validate)
        bash "$LIB_DIR/validate.sh" "$@"
        ;;

    graph)
        exec node "$LIB_DIR/runner-chain-graph.js" "$@"
        ;;

    seed)
        # seed namespace with example agents, chains, and config profiles
        SEED_SCRIPT="$SCRIPT_DIR/../web/scripts/seed.ts"
        if [[ ! -f "$SEED_SCRIPT" ]]; then
            echo "  error: seed script not found: $SEED_SCRIPT"
            exit 1
        fi
        if command -v npx &>/dev/null && npx tsx --version &>/dev/null 2>&1; then
            NAMESPACE_ID="${NAMESPACE_ID:-default}" npx tsx "$SEED_SCRIPT"
        elif command -v tsx &>/dev/null; then
            NAMESPACE_ID="${NAMESPACE_ID:-default}" tsx "$SEED_SCRIPT"
        else
            echo "  error: tsx not found. install with: npm install -g tsx"
            exit 1
        fi
        ;;

    auth)
        # Credential for every ops-endpoint command. Shares the sidecar with the
        # MCP bridge (~/.mentiko/mcp/session.json), so authorizing once covers both.
        exec node "$LIB_DIR/mentiko-cli-auth.mjs" "$@"
        ;;

    decision)
        node "$LIB_DIR/mentiko-cli-decision.mjs" "$@"
        ;;

    generation)
        node "$LIB_DIR/runner-generation-payload-import.js" "$@"
        ;;

    list_schedules|create_schedule|update_schedule|delete_schedule|run_schedule_now|list_applications|register_application|update_application|delete_application)
        node "$LIB_DIR/mentiko-cli-schedules.mjs" "$CMD" "$@"
        ;;

    list_tasks|get_task|create_task|update_task|close_task|comment_task|link_task|unlink_task)
        node "$LIB_DIR/mentiko-cli-tasks.mjs" "$CMD" "$@"
        ;;

    # -------------------------------------------------------------------
    # spec mode (legacy, still works)
    # -------------------------------------------------------------------

    launch)
        exec node "$LIB_DIR/runner-v2-standalone-agent-launch.js" "$@"
        ;;

    peek)
        SESSION="${1:-}"
        LINES="${2:-50}"

        if [[ -z "$SESSION" ]]; then
            echo "usage: mentiko peek <session-name> [lines]"
            exit 1
        fi

        if ! transport_has_session "$SESSION" 2>/dev/null; then
            echo "  error: session not found: $SESSION"
            exit 1
        fi

        transport_capture "$SESSION" "$LINES"
        ;;

    send)
        SESSION="${1:-}"
        MESSAGE="${2:-}"

        if [[ -z "$SESSION" || -z "$MESSAGE" ]]; then
            echo "usage: mentiko send <session-name> \"message\""
            exit 1
        fi

        if ! transport_has_session "$SESSION" 2>/dev/null; then
            echo "  error: session not found: $SESSION"
            exit 1
        fi

        transport_send_keys "$SESSION" "$MESSAGE"
        echo "  sent to $SESSION"

        node "$LIB_DIR/runner-audit.js" write \
            --namespace-id "$NAMESPACE_ID" \
            --event-type "agent_action" \
            --description "Agent action: send $SESSION" \
            --meta action="send" --meta target="$SESSION" --meta details="message: ${MESSAGE:0:100}" \
            --source "cli" >/dev/null || true
        ;;

    kill)
        SESSION="${1:-}"

        if [[ -z "$SESSION" ]]; then
            echo "usage: mentiko kill <session-name>"
            exit 1
        fi

        if ! transport_has_session "$SESSION" 2>/dev/null; then
            echo "  error: session not found: $SESSION"
            exit 1
        fi

        transport_kill_session "$SESSION"
        echo "  killed: $SESSION"

        node "$LIB_DIR/runner-audit.js" write \
            --namespace-id "$NAMESPACE_ID" \
            --event-type "agent_action" \
            --description "Agent action: kill $SESSION" \
            --meta action="kill" --meta target="$SESSION" \
            --source "cli" >/dev/null || true
        ;;

    kill-all)
        killed=0
        for session in $(transport_list_sessions); do
            transport_kill_session "$session"
            ((killed++))
        done
        echo "  killed $killed sessions"
        ;;

    list)
        sessions=$(transport_list_sessions)
        if [[ -z "$sessions" ]]; then
            echo "  no active sessions"
        else
            echo "$sessions"
        fi
        ;;

    events)
        EVENT_LIST_ARGS=(list --events-dir "$EVENTS_DIR" --output text)
        if [[ -n "${1:-}" ]]; then
            if [[ "$1" != "--unprocessed" || -n "${2:-}" ]]; then
                echo "usage: mentiko events [--unprocessed]" >&2
                exit 1
            fi
            EVENT_LIST_ARGS+=(--unprocessed)
        fi

        if [[ ! -d "$EVENTS_DIR" ]]; then
            echo "  no events directory"
            exit 1
        fi

        node "${MENTIKO_CODE_ROOT:?MENTIKO_CODE_ROOT must be configured}/lib/runner-event-lifecycle.js" \
            "${EVENT_LIST_ARGS[@]}"
        ;;

    emit)
        # Pull global flags out of the positionals before <event> [source] [data]
        # parsing, so `--web-url` is not swallowed as the data argument.
        EMIT_WEB_URL=""
        EMIT_POS=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --web-url) EMIT_WEB_URL="${2:-}"; shift 2;;
                *) EMIT_POS+=("$1"); shift;;
            esac
        done
        set -- "${EMIT_POS[@]}"

        EVENT_SCOPE="run"
        if [[ "${1:-}" == "--scope" ]]; then
            if [[ -z "${2:-}" ]]; then
                echo "  error: --scope requires run or ingress"
                echo "  usage: mentiko emit [--scope run|ingress] <event-name> [source] [data]"
                exit 1
            fi
            EVENT_SCOPE="${2:-}"
            shift 2
        fi
        if [[ "$EVENT_SCOPE" != "run" && "$EVENT_SCOPE" != "ingress" ]]; then
            echo "  error: event scope must be run or ingress"
            echo "  usage: mentiko emit [--scope run|ingress] <event-name> [source] [data]"
            exit 1
        fi
        EVENT_NAME="${1:-}"
        SOURCE="${2:-${MENTIKO_AGENT_ID:-}}"
        DATA="${3:-}"

        # `mentiko emit --help` must print usage, NOT emit an event literally named "--help"
        # (agents probe the command this way and were polluting the event stream).
        if [[ "$EVENT_NAME" == "--help" || "$EVENT_NAME" == "-h" || "$EVENT_NAME" == "help" ]]; then
            echo "usage: mentiko emit [--scope run|ingress] <event-name> [source] [data]"
            echo "  run is the default and requires MENTIKO_RUN_ID or RUN_ID"
            echo "  ingress must be requested explicitly and must not carry a run id"
            echo "  source defaults to \$MENTIKO_AGENT_ID"
            exit 0
        fi
        if [[ -z "$EVENT_NAME" ]]; then
            echo "usage: mentiko emit [--scope run|ingress] <event-name> [source] [data]"
            exit 1
        fi
        if [[ -z "$SOURCE" ]]; then
            echo "  error: no source given and MENTIKO_AGENT_ID is not set"
            echo "  usage: mentiko emit [--scope run|ingress] <event-name> [source] [data]"
            exit 1
        fi

        # Route through the ops endpoint (ns/org from the verified token); the
        # client degrades to the local typed writer if the web process is down, so
        # the completion signal never fails closed. Same flag contract as the bundle.
        EMIT_CLIENT="${MENTIKO_CODE_ROOT:?MENTIKO_CODE_ROOT must be configured}/lib/mentiko-cli-emit.mjs"
        if ! node "$EMIT_CLIENT" emit \
            --scope "$EVENT_SCOPE" \
            --event "$EVENT_NAME" \
            --source "$SOURCE" \
            --run-id "${MENTIKO_RUN_ID:-${RUN_ID:-}}" \
            --data "$DATA" \
            ${EMIT_WEB_URL:+--web-url "$EMIT_WEB_URL"}
        then
            echo "  error: runner event emission failed (http + local fallback)" >&2
            exit 1
        fi

        node "$LIB_DIR/runner-audit.js" write \
            --namespace-id "$NAMESPACE_ID" \
            --event-type "event_emit" \
            --description "Event emitted: $EVENT_NAME" \
            --meta event_name="$EVENT_NAME" --meta source="$SOURCE" \
            --source "cli" >/dev/null || true
        ;;

    init)
        TARGET_DIR="${1:-.}"
        mkdir -p "$TARGET_DIR/agents"/{state,events,specs}
        mkdir -p "$TARGET_DIR/reports"
        cat > "$TARGET_DIR/chain.json" <<'EOF'
{
  "name": "my-chain",
  "description": "A simple agent chain",
  "version": "1.0",
  "namespace_id": "default",
  "config": {
    "cli": "claude",
    "monitor": true,
    "max_rounds": 3,
    "session_prefix": "my-chain"
  },
  "agents": [
    {
      "id": "worker",
      "name": "Worker Agent",
      "role": "Does the work",
      "triggers": ["manual-start"],
      "emits": "work-complete",
      "spec": { "$ref": "agents/my-agent/spec.md" }
    }
  ]
}
EOF
        # create example agent spec
        mkdir -p "$TARGET_DIR/agents/my-agent"
        cat > "$TARGET_DIR/agents/my-agent/spec.md" <<'EOF'
# Worker Agent

Complete the assigned task efficiently.
EOF
        echo "  initialized mentiko in $TARGET_DIR"
        echo "  edit chain.json to define your agents"
        ;;

    # -------------------------------------------------------------------
    # typed manual monitor (profile-aware agent monitor)
    # -------------------------------------------------------------------

    monitor)
        node "$LIB_DIR/runner-manual-monitor.js" "$@"
        ;;

    # -------------------------------------------------------------------
    # audit logging
    # -------------------------------------------------------------------

    audit)
        AUDIT_SUBCMD="${1:-summary}"
        shift || true

        case "$AUDIT_SUBCMD" in
            summary)
                node "$LIB_DIR/runner-audit.js" summary --namespace-id "$NAMESPACE_ID"
                ;;
            export-json)
                OUTPUT="${1:-}"
                SINCE="${2:-}"
                EVENT="${3:-}"
                EXPORT_ARGS=(export-json --namespace-id "$NAMESPACE_ID")
                [[ -n "$OUTPUT" ]] && EXPORT_ARGS+=(--output "$OUTPUT")
                [[ -n "$SINCE" ]] && EXPORT_ARGS+=(--since "$SINCE")
                [[ -n "$EVENT" ]] && EXPORT_ARGS+=(--event-type "$EVENT")
                node "$LIB_DIR/runner-audit.js" "${EXPORT_ARGS[@]}"
                ;;
            export-csv)
                OUTPUT="${1:-}"
                SINCE="${2:-}"
                EVENT="${3:-}"
                EXPORT_ARGS=(export-csv --namespace-id "$NAMESPACE_ID")
                [[ -n "$OUTPUT" ]] && EXPORT_ARGS+=(--output "$OUTPUT")
                [[ -n "$SINCE" ]] && EXPORT_ARGS+=(--since "$SINCE")
                [[ -n "$EVENT" ]] && EXPORT_ARGS+=(--event-type "$EVENT")
                node "$LIB_DIR/runner-audit.js" "${EXPORT_ARGS[@]}"
                ;;
            query)
                TYPE="${1:-all}"
                VALUE="${2:-}"
                SINCE="${3:-}"
                LIMIT="${4:-100}"
                QUERY_ARGS=(query --namespace-id "$NAMESPACE_ID" --filter-type "$TYPE" --filter-value "$VALUE" --limit "$LIMIT")
                [[ -n "$SINCE" ]] && QUERY_ARGS+=(--since "$SINCE")
                node "$LIB_DIR/runner-audit.js" "${QUERY_ARGS[@]}"
                ;;
            archive)
                DAYS="${1:-30}"
                node "$LIB_DIR/runner-audit.js" archive --namespace-id "$NAMESPACE_ID" --days "$DAYS"
                ;;
            clear)
                if [[ "${1:-}" != "--confirm" ]]; then
                    echo "  warning: this will delete all audit logs"
                    echo "  usage: mentiko audit clear --confirm"
                    exit 1
                fi
                node "$LIB_DIR/runner-audit.js" clear --namespace-id "$NAMESPACE_ID" --confirm true
                ;;
            *)
                echo "  audit subcommands:"
                echo "    summary [since]     - show audit log summary"
                echo "    export-json [file] [since] [event-type]"
                echo "    export-csv [file] [since] [event-type]"
                echo "    query <type> <value> [since] [limit]"
                echo "      types: all, event_type, user, chain, run_id, auth"
                echo "    archive [days]      - archive old logs"
                echo "    clear --confirm     - delete all logs"
                ;;
        esac
        ;;

    *)
        cat <<'EOF'
mentiko - AI agent chain orchestration

usage:
  mentiko run <chain.json> [--workspace <path>] [--task <id>] [--start <agent-id>] [--dry-run] [--debug]
  mentiko generate "<prompt>" [--output <dir>] [--template <file>] [--json] [--raw]
  mentiko launch <spec-file> [--monitor]
  mentiko validate <chain.json> [--strict]
  mentiko graph <chain.json>
  mentiko peek <session-name> [lines]
  mentiko send <session-name> "message"
  mentiko kill <session-name>
  mentiko kill-all
  mentiko list
  mentiko events [--unprocessed]
  mentiko emit [--scope run|ingress] <event-name> [source] [data]
  mentiko init [directory]
  mentiko monitor <session> "end state" [profile] [interval]
  mentiko audit [summary|export-json|export-csv|query|archive|clear]
  mentiko seed

examples:
  mentiko run examples/my-chain/chain.json --workspace ~/projects/my-app
  mentiko validate examples/my-chain/chain.json
  mentiko monitor my-agent "build passes" mentiko 60
  mentiko audit summary
  mentiko audit export-json logs.json
  mentiko audit export-csv logs.csv "2025-01-01"
  mentiko audit query auth "" "7 days ago"
EOF
        ;;
esac
