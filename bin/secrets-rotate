#!/usr/bin/env node
/**
 * Standalone secret key rotation CLI tool.
 *
 * Usage:
 *   bin/secrets-rotate [options]
 *
 * Options:
 *   --namespace-id <id>    namespace to rotate (default: "default")
 *   --org-id <id>          org to rotate (default: "default")
 *   --old-secret <value>   old BETTER_AUTH_SECRET (or set BETTER_AUTH_SECRET_OLD env)
 *   --dry-run              detect and report, do not write
 *   --same-key             v0 format upgrade only (no old key needed)
 *   --all-namespaces       rotate every namespace found
 *   --yes                  skip confirmation prompt
 *   --verbose              print each secret name + result
 */

import { readFileSync, readdirSync, existsSync, writeFileSync, renameSync } from "fs";
import { join } from "path";
import { homedir } from "os";
import {
  createDecipheriv,
  createCipheriv,
  createHash,
  createHmac,
  pbkdf2Sync,
  randomBytes,
} from "crypto";
import * as readline from "readline";

const args = process.argv.slice(2);
let namespaceId = "default";
let orgId = "default";
let oldSecret = process.env.BETTER_AUTH_SECRET_OLD || null;
let dryRun = false;
let sameKey = false;
let allNamespaces = false;
let yes = false;
let verbose = false;

// parse args
for (let i = 0; i < args.length; i++) {
  const arg = args[i];
  if (arg === "--namespace-id" && i + 1 < args.length) {
    namespaceId = args[++i];
  } else if (arg === "--org-id" && i + 1 < args.length) {
    orgId = args[++i];
  } else if (arg === "--old-secret" && i + 1 < args.length) {
    oldSecret = args[++i];
  } else if (arg === "--dry-run") {
    dryRun = true;
  } else if (arg === "--same-key") {
    sameKey = true;
  } else if (arg === "--all-namespaces") {
    allNamespaces = true;
  } else if (arg === "--yes") {
    yes = true;
  } else if (arg === "--verbose") {
    verbose = true;
  }
}

// ── helpers ────────────────────────────────────────────────────────────────

const KEY_DERIVATION_SALT = "mentiko-vault-crypto-v1";
const KEY_DERIVATION_LABEL = "mentiko-vault-encryption-v1";
const KEY_DERIVATION_ITERATIONS = 100000;
const KEY_LENGTH_BYTES = 32;

function getVaultSecret() {
  const direct = process.env.VAULT_ENCRYPTION_KEY;
  if (direct) return direct;

  const fallback = process.env.BETTER_AUTH_SECRET || process.env.SECRET_KEY;
  if (!fallback) {
    throw new Error("BETTER_AUTH_SECRET is required to rotate secrets");
  }
  return fallback;
}

function getVaultPreviousSecret() {
  return process.env.VAULT_ENCRYPTION_KEY_OLD || process.env.BETTER_AUTH_SECRET_OLD || null;
}

function deriveVaultAppSecret(rootSecret) {
  const prk = createHmac("sha256", "\x00".repeat(32)).update(rootSecret).digest();
  return createHmac("sha256", prk).update(`${KEY_DERIVATION_LABEL}\x01`).digest("hex");
}

function getDerivedKey(secret) {
  // double HKDF to match secrets-store.ts
  const appSecret = deriveVaultAppSecret(deriveVaultAppSecret(secret || getVaultSecret()));
  return pbkdf2Sync(
    appSecret,
    KEY_DERIVATION_SALT,
    KEY_DERIVATION_ITERATIONS,
    KEY_LENGTH_BYTES,
    "sha256"
  );
}

function getLegacyDerivedKey(secret) {
  const rawSecret = secret || getVaultSecret();
  return pbkdf2Sync(
    rawSecret,
    KEY_DERIVATION_SALT,
    KEY_DERIVATION_ITERATIONS,
    KEY_LENGTH_BYTES,
    "sha256"
  );
}

function getKeyId(key) {
  return createHash("sha256").update(key).digest("hex").slice(0, 16);
}

function getKeyCandidates(secret) {
  const primary = getDerivedKey(secret);
  const legacy = getLegacyDerivedKey(secret);
  if (legacy.equals(primary)) return [primary];
  return [primary, legacy];
}

function decrypt(ciphertext, secret) {
  const candidates = getKeyCandidates(secret);

  if (ciphertext.startsWith("v1:")) {
    const parts = ciphertext.split(":", 5);
    if (parts.length !== 5) return null;
    const [, keyIdStored, ivHex, tagHex, encHex] = parts;

    for (const key of candidates) {
      if (getKeyId(key) !== keyIdStored) {
        continue;
      }
      try {
        const decipher = createDecipheriv("aes-256-gcm", key, Buffer.from(ivHex, "hex"));
        decipher.setAuthTag(Buffer.from(tagHex, "hex"));
        return Buffer.concat([decipher.update(Buffer.from(encHex, "hex")), decipher.final()]).toString("utf8");
      } catch {
        // try next key
      }
    }
    return null;
  }

  // v0 format: ivHex:tagHex:encHex
  const parts = ciphertext.split(":");
  if (parts.length !== 3) return null;
  const [ivHex, tagHex, encHex] = parts;

  for (const key of candidates) {
    try {
      const decipher = createDecipheriv("aes-256-gcm", key, Buffer.from(ivHex, "hex"));
      decipher.setAuthTag(Buffer.from(tagHex, "hex"));
      return Buffer.concat([decipher.update(Buffer.from(encHex, "hex")), decipher.final()]).toString("utf8");
    } catch {
      // try next key
    }
  }
  return null;
}

function encrypt(plaintext, secret) {
  const key = getDerivedKey(secret);
  const keyId = getKeyId(key);
  const iv = randomBytes(12);
  const cipher = createCipheriv("aes-256-gcm", key, iv);
  const encrypted = Buffer.concat([cipher.update(plaintext, "utf8"), cipher.final()]);
  const tag = cipher.getAuthTag();
  return `v1:${keyId}:${iv.toString("hex")}:${tag.toString("hex")}:${encrypted.toString("hex")}`;
}

function canDecryptWithCurrent(ciphertext, currentSecret) {
  return !!decrypt(ciphertext, currentSecret);
}

function rotateSecretsInOrg(ns, orgId, currentSecret, oldSecret, opts = {}) {
  const mentiko = process.env.MENTIKO_GLOBAL_ROOT || join(homedir(), ".mentiko");
  const orgRoot = orgId === "default"
    ? join(mentiko, "namespaces", ns)
    : join(mentiko, "namespaces", ns, "orgs", orgId);
  const secretsDir = join(orgRoot, "secrets");

  if (!existsSync(secretsDir)) {
    return { ok: true, total: 0, rotated: 0, skipped: 0, failed: 0 };
  }

  const currentKeyId = getKeyId(getDerivedKey(currentSecret));
  const files = readdirSync(secretsDir).filter((f) => f.endsWith(".json"));
  const failures = [];
  let rotated = 0;
  let skipped = 0;
  let dryRunNeeds = 0;
  let dryRunCurrent = 0;

  for (const f of files) {
    const p = join(secretsDir, f);
    try {
      const rec = JSON.parse(readFileSync(p, "utf-8"));

      if (rec.keyId === currentKeyId) {
        if (opts.dryRun) {
          dryRunCurrent++;
        } else {
          skipped++;
        }
        continue;
      }

      if (opts.dryRun) {
        if (!rec.keyId && canDecryptWithCurrent(rec.encryptedValue, currentSecret)) {
          dryRunCurrent++;
        } else {
          dryRunNeeds++;
        }
        continue;
      }

      const plaintext = decrypt(rec.encryptedValue, oldSecret);
      if (!plaintext) {
        failures.push({
          id: rec.id,
          name: rec.name,
          error: "decryption failed with old key",
        });
        if (verbose) {
          console.log(`  ✖ ${rec.name} (${rec.id}): decryption failed`);
        }
        continue;
      }

      rec.encryptedValue = encrypt(plaintext, currentSecret);
      rec.keyId = currentKeyId;
      rec.updatedAt = new Date().toISOString();

      const tmpPath = `${p}.tmp`;
      writeFileSync(tmpPath, JSON.stringify(rec, null, 2), { mode: 0o600 });
      renameSync(tmpPath, p);
      rotated++;

      if (verbose) {
        console.log(`  ✔ ${rec.name} (${rec.id}): rotated`);
      }
    } catch (err) {
      failures.push({
        id: f.replace(".json", ""),
        name: f,
        error: err instanceof Error ? err.message : String(err),
      });
      if (verbose) {
        console.log(`  ✖ ${f}: error`);
      }
    }
  }

  if (opts.dryRun) {
    return {
      ok: true,
      total: files.length,
      needsRotation: dryRunNeeds,
      alreadyCurrent: dryRunCurrent,
      dryRun: true,
    };
  }

  return {
    ok: failures.length === 0,
    total: files.length,
    rotated,
    skipped,
    failed: failures.length,
    failures: failures.length > 0 ? failures : undefined,
  };
}

async function main() {
  const currentSecret = getVaultSecret();
  let oldEffective = sameKey ? currentSecret : oldSecret;

  if (!sameKey && !oldEffective) {
    if (dryRun) {
      console.log("(dry run mode, old secret not needed)");
    } else {
      const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
      oldSecret = await new Promise((resolve) => {
        rl.question("Enter old BETTER_AUTH_SECRET (hidden): ", (answer) => {
          rl.close();
          resolve(answer);
        });
      });
      oldSecret = String(oldSecret || "");
      oldEffective = oldSecret;
    }
  }

  if (!sameKey && !oldEffective) {
    oldEffective = getVaultPreviousSecret();
  }

  if (!sameKey && !dryRun && !oldEffective) {
    console.error("error: old secret is required for rotation");
    process.exit(1);
  }

  // collect namespaces
  let namespaces = [];
  if (allNamespaces) {
    const mentiko = process.env.MENTIKO_GLOBAL_ROOT || join(homedir(), ".mentiko");
    const nsDir = join(mentiko, "namespaces");
    if (existsSync(nsDir)) {
      namespaces = readdirSync(nsDir).filter((d) =>
        existsSync(join(nsDir, d, "secrets")) || existsSync(join(nsDir, d, "orgs"))
      );
    }
    if (namespaces.length === 0) {
      console.log("no namespaces found");
      process.exit(2);
    }
  } else {
    namespaces = [namespaceId];
  }

  // confirmation
  const summary = allNamespaces ? "all namespaces" : `${namespaceId}/${orgId}`;
  if (!yes && !dryRun) {
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    await new Promise((resolve) => {
      rl.question(`rotate secrets in ${summary}? [y/N] `, (answer) => {
        rl.close();
        if (answer.toLowerCase() !== "y") {
          console.log("aborted");
          process.exit(0);
        }
        resolve();
      });
    });
  }

  // rotate
  let totalSecrets = 0;
  let totalRotated = 0;
  let totalFailed = 0;
  const allFailures = [];

  for (const ns of namespaces) {
    const useOld = sameKey ? currentSecret : (oldEffective || currentSecret);
    const result = rotateSecretsInOrg(ns, orgId, currentSecret, useOld, { dryRun });
    if (result.total === 0) continue;

    if (dryRun) {
      console.log(
        `${ns}/${orgId}: ${result.needsRotation} need rotation, ${result.alreadyCurrent} already current`
      );
    } else {
      console.log(`${ns}/${orgId}: ${result.rotated}/${result.total} rotated, ${result.failed} failed`);
      totalSecrets += result.total;
      totalRotated += result.rotated;
      totalFailed += result.failed;
      if (result.failures) {
        allFailures.push(...result.failures);
      }
    }
  }

  if (dryRun) {
    console.log("\ndry run complete, no changes made");
    process.exit(0);
  }

  if (totalFailed > 0) {
    console.log(`\n${totalFailed} secret(s) failed to rotate:`);
    for (const f of allFailures.slice(0, 10)) {
      console.log(`  - ${f.name} (${f.id}): ${f.error}`);
    }
    process.exit(1);
  }

  if (totalRotated === 0) {
    console.log("no secrets found to rotate");
    process.exit(2);
  }

  console.log(`\n✔ ${totalRotated}/${totalSecrets} secrets rotated successfully`);
  process.exit(0);
}

main().catch((err) => {
  console.error("error:", err.message);
  process.exit(1);
});
