#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/../lib/config.sh"

# cross-platform md5 (macOS md5 -q vs Linux md5sum)
_md5() { if command -v md5 >/dev/null 2>&1; then md5 -q; else md5sum | cut -d' ' -f1; fi; }

SESSION_A="${1:-}"
SESSION_B="${2:-}"

if [[ -z "$SESSION_A" || -z "$SESSION_B" ]]; then
  echo "  usage: peer-swarm-watch <session-a> <session-b>"
  exit 1
fi

if ! "$BIN_DIR/p" alive "$SESSION_A" >/dev/null 2>&1; then
  echo "  error: session '$SESSION_A' not found"
  exit 1
fi

if ! "$BIN_DIR/p" alive "$SESSION_B" >/dev/null 2>&1; then
  echo "  error: session '$SESSION_B' not found"
  exit 1
fi

CACHE_DIR="/tmp/peer-watch-$$"
mkdir -p "$CACHE_DIR"

_cleanup() {
  tput cnorm 2>/dev/null
  rm -rf "$CACHE_DIR"
  clear
  exit
}
trap _cleanup INT TERM

check_activity() {
  local session="$1"
  local hash_file="$CACHE_DIR/${session}_hash"
  local output_file="$CACHE_DIR/${session}_output"
  
  local capture
  capture=$("$BIN_DIR/p" capture "$session" 2>/dev/null || echo "")
  
  if [[ -z "$capture" ]]; then
    echo "dead"
    return
  fi
  
  echo "$capture" > "$output_file"
  
  local hash=$(echo "$capture" | _md5)
  local old_hash=""
  [[ -f "$hash_file" ]] && old_hash=$(cat "$hash_file")
  
  if [[ "$old_hash" != "$hash" ]]; then
    echo "$hash" > "$hash_file"
    echo "active"
  else
    echo "idle"
  fi
}

clear
tput civis
echo "  watching: $SESSION_A | $SESSION_B"
echo "  press ctrl+c to stop"
echo ""
sleep 2

while true; do
  if ! "$BIN_DIR/p" alive "$SESSION_A" >/dev/null 2>&1; then
    clear; echo "  $SESSION_A exited"; tput cnorm; exit 0
  fi
  if ! "$BIN_DIR/p" alive "$SESSION_B" >/dev/null 2>&1; then
    clear; echo "  $SESSION_B exited"; tput cnorm; exit 0
  fi
  
  status_a=$(check_activity "$SESSION_A")
  status_b=$(check_activity "$SESSION_B")
  
  show_side="none"
  [[ "$status_a" == "active" && "$status_b" == "idle" ]] && show_side="left"
  [[ "$status_b" == "active" && "$status_a" == "idle" ]] && show_side="right"
  [[ "$status_a" == "active" && "$status_b" == "active" ]] && show_side="left"
  
  clear
  printf "  \033[1;34m%-49s\033[0m│\033[1;35m%-49s\033[0m\n" "$SESSION_A" "$SESSION_B"
  printf "  %s\n" "$(printf '─%.0s' {1..99})"
  
  output_a=$(cat "$CACHE_DIR/${SESSION_A}_output" 2>/dev/null || echo "")
  output_b=$(cat "$CACHE_DIR/${SESSION_B}_output" 2>/dev/null || echo "")
  
  display_a=$(echo "$output_a" | tail -35)
  display_b=$(echo "$output_b" | tail -35)
  
  if [[ "$show_side" == "left" ]]; then
    echo "$display_a" | while IFS= read -r line; do
      line=$(echo "$line" | sed 's/\t/  /g' | cut -c1-50)
      printf "  %-50s│\n" "$line"
    done
    line_count=$(echo "$display_a" | wc -l)
    for ((i=line_count; i<35; i++)); do
      printf "  %-50s│\n" ""
    done
  elif [[ "$show_side" == "right" ]]; then
    echo "$display_b" | while IFS= read -r line; do
      line=$(echo "$line" | sed 's/\t/  /g' | cut -c1-50)
      printf "  %50s│%-50s\n" "" "$line"
    done
    line_count=$(echo "$display_b" | wc -l)
    for ((i=line_count; i<35; i++)); do
      printf "  %50s│%-50s\n" "" ""
    done
  else
    for ((i=0; i<35; i++)); do
      printf "  %50s│%50s\n" "" ""
    done
  fi
  
  printf "  %s\n" "$(printf '─%.0s' {1..99})"
  printf "  \033[1;33m%s\033[0m\n" "showing: $show_side | A:$status_a | B:$status_b"
  
  sleep 0.5
done
